# If not running interactively, don't do anything (leave this at the top of this file)
[[ $- != *i* ]] && return

# All the default R2-D2 aliases and functions
# (don't mess with these directly, just overwrite them here!)
source ~/.config/bash/rc

# Load SSH keys into agent (keychain 3.x).
# --immediate skips the "Press Enter to initialize keys" gate that otherwise
# blocks Cursor/IDE terminals until you type something (stderr was also being
# discarded, so the prompt was invisible). One call loads all present keys.
if command -v keychain &>/dev/null; then
  eval "$(keychain add --eval --immediate --ignore-missing --quiet \
    id_git_ssh id_rsa_ssh_login id_ssh_login)"
fi

