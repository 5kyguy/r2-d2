# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="{{colors.bg.default.hex}}"

# Main text color
theme[main_fg]="{{colors.text.default.hex}}"

# Title color for boxes
theme[title]="{{colors.on_accent.default.hex}}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{colors.on_accent.default.hex}}"

# Background color of selected item in processes box
theme[selected_bg]="{{colors.accent.default.hex}}"

# Foreground color of selected item in processes box
theme[selected_fg]="{{colors.on_accent.default.hex}}"

# Color of inactive/disabled text
theme[inactive_fg]="{{colors.line.default.hex}}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{colors.muted.default.hex}}"

# Cpu box outline color
theme[cpu_box]="{{colors.spark.default.hex}}"

# Memory/disks box outline color
theme[mem_box]="{{colors.spark.default.hex}}"

# Net up/down box outline color
theme[net_box]="{{colors.spark.default.hex}}"

# Processes box outline color
theme[proc_box]="{{colors.spark.default.hex}}"

# Box divider line and small boxes line color
theme[div_line]="{{colors.spark.default.hex}}"

# Temperature graph colors
theme[temp_start]="{{colors.deep.default.hex}}"
theme[temp_mid]="{{colors.accent.default.hex}}"
theme[temp_end]="{{colors.danger.default.hex}}"

# CPU graph colors
theme[cpu_start]="{{colors.deep.default.hex}}"
theme[cpu_mid]="{{colors.accent.default.hex}}"
theme[cpu_end]="{{colors.danger.default.hex}}"

# Mem/Disk free meter
theme[free_start]="{{colors.deep.default.hex}}"
theme[free_mid]="{{colors.accent.default.hex}}"
theme[free_end]="{{colors.danger.default.hex}}"

# Mem/Disk cached meter
theme[cached_start]="{{colors.deep.default.hex}}"
theme[cached_mid]="{{colors.accent.default.hex}}"
theme[cached_end]="{{colors.danger.default.hex}}"

# Mem/Disk available meter
theme[available_start]="{{colors.deep.default.hex}}"
theme[available_mid]="{{colors.accent.default.hex}}"
theme[available_end]="{{colors.danger.default.hex}}"

# Mem/Disk used meter
theme[used_start]="{{colors.deep.default.hex}}"
theme[used_mid]="{{colors.accent.default.hex}}"
theme[used_end]="{{colors.danger.default.hex}}"

# Download graph colors
theme[download_start]="{{colors.deep.default.hex}}"
theme[download_mid]="{{colors.accent.default.hex}}"
theme[download_end]="{{colors.danger.default.hex}}"

# Upload graph colors
theme[upload_start]="{{colors.deep.default.hex}}"
theme[upload_mid]="{{colors.accent.default.hex}}"
theme[upload_end]="{{colors.danger.default.hex}}"
