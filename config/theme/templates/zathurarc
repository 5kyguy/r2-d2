# R2-D2 zathura theme: Fixed palette from the wallpaper accent.
# AUTO-GENERATED from the fixed palette — do not edit.

set notification-error-bg       "{{colors.danger.default.hex}}"
set notification-error-fg       "{{colors.on_danger.default.hex}}"
set notification-warning-bg     "{{colors.warning.default.hex}}"
set notification-warning-fg     "{{colors.on_warning.default.hex}}"
set notification-bg             "{{colors.surface.default.hex}}"
set notification-fg             "{{colors.text.default.hex}}"

set completion-bg               "{{colors.surface.default.hex}}"
set completion-fg               "{{colors.text.default.hex}}"
set completion-group-bg         "{{colors.surface.default.hex}}"
set completion-group-fg         "{{colors.spark.default.hex}}"
set completion-highlight-bg     "{{colors.accent.default.hex}}"
set completion-highlight-fg     "{{colors.on_accent.default.hex}}"

set index-bg                    "{{colors.surface.default.hex}}"
set index-fg                    "{{colors.text.default.hex}}"
set index-active-bg             "{{colors.deep.default.hex}}"
set index-active-fg             "{{colors.text.default.hex}}"

set inputbar-bg                 "{{colors.surface.default.hex}}"
set inputbar-fg                 "{{colors.text.default.hex}}"
set statusbar-bg                "{{colors.surface.default.hex}}"
set statusbar-fg                "{{colors.text.default.hex}}"

set highlight-color             "{{colors.accent.default.hex}}"
set highlight-active-color      "{{colors.spark.default.hex}}"
set default-bg                   "{{colors.surface.default.hex}}"
set default-fg                   "{{colors.text.default.hex}}"

set render-loading              true
# The page keeps the PDF's own colors. Bars, input, and the index stay themed.
set recolor                     false
set adjust-open                 width
set scroll-page-aware            true
set selection-clipboard         clipboard

set font                        "JetBrainsMono Nerd Font 10"
set statusbar-basename          true
set statusbar-page-percent      true
set statusbar-h-padding         10
set statusbar-v-padding         6
set scroll-step                 60
set zoom-min                    20
set zoom-max                    500

map n navigate next
map N navigate previous
map t search next
map T search previous

set window-title-basename          true
set scroll-full-overlap            0.15
set guioptions                     "s"
set show-hidden                    false
set zoom-step                      10

map d scroll half-down
map u scroll half-up
map f toggle_fullscreen
map i toggle_index
