# R2-D2 zathura theme: Fixed palette from the wallpaper accent.
# AUTO-GENERATED from the fixed palette — do not edit.

set notification-error-bg       "#ff2a4a"
set notification-error-fg       "#2a0008"
set notification-warning-bg     "#ffb000"
set notification-warning-fg     "#2a2100"
set notification-bg             "#181818"
set notification-fg             "#f7f7f7"

set completion-bg               "#181818"
set completion-fg               "#f7f7f7"
set completion-group-bg         "#181818"
set completion-group-fg         "#f7f7f7"
set completion-highlight-bg     "#ffffff"
set completion-highlight-fg     "#0a0a0a"

set index-bg                    "#181818"
set index-fg                    "#f7f7f7"
set index-active-bg             "#e6e6e6"
set index-active-fg             "#f7f7f7"

set inputbar-bg                 "#181818"
set inputbar-fg                 "#f7f7f7"
set statusbar-bg                "#181818"
set statusbar-fg                "#f7f7f7"

set highlight-color             "#ffffff"
set highlight-active-color      "#f7f7f7"
set default-bg                   "#181818"
set default-fg                   "#f7f7f7"

set render-loading              true
# The page keeps the PDF's own colors. Bars, input, and the index stay themed.
set recolor                     false
set adjust-open                 width
set scroll-page-aware            true
set selection-clipboard         clipboard

set font                        "JetBrainsMono Nerd Font 10"
set statusbar-basename          true
set statusbar-page-percent      true
set statusbar-h-padding         10
set statusbar-v-padding         6
set scroll-step                 60
set zoom-min                    20
set zoom-max                    500

map n navigate next
map N navigate previous
map t search next
map T search previous

set window-title-basename          true
set scroll-full-overlap            0.15
set guioptions                     "s"
set show-hidden                    false
set zoom-step                      10

map d scroll half-down
map u scroll half-up
map f toggle_fullscreen
map i toggle_index
