# Switching between the stock providers is a one-click toggle, so it must not
# stop for a password. Custom is deliberately absent: it points the machine at
# servers the caller supplies, and it already runs in a terminal that can ask.
%wheel ALL=(root) NOPASSWD: /usr/local/bin/r2-d2-setup-dns Cloudflare, /usr/local/bin/r2-d2-setup-dns Google, /usr/local/bin/r2-d2-setup-dns DHCP
