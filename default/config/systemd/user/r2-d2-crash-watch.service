[Unit]
Description=Announce process crashes and offer a K-2SO diagnosis
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
ConditionPathExists=!%h/.local/state/r2-d2/toggles/crash-capture-off

[Service]
Type=simple
ExecStart=%h/.local/share/r2-d2/bin/r2-d2-crash-watch
Environment=R2D2_PATH=%h/.local/share/r2-d2
Environment=PATH=%h/.local/share/r2-d2/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
