#!/bin/bash

# Fill backgrounds/accents.toml, the pre-stored per-wallpaper accent map that
# r2-d2-theme-bg-set applies instantly (no pixel pass at pick time). Existing
# entries are kept, so hand-curated values survive backfills; --refresh
# recomputes every entry. Entries for images that no longer exist are dropped.

set -euo pipefail

R2D2_ROOT="${R2D2_PATH:-$HOME/.local/share/r2-d2}"
BACKGROUND_DIR="$R2D2_ROOT/backgrounds"
MANIFEST="$BACKGROUND_DIR/accents.toml"

refresh=false
if [[ ${1:-} == "--refresh" && $# == 1 ]]; then
  refresh=true
elif (( $# > 0 )); then
  echo "Usage: r2-d2-theme-bg-accents [--refresh]" >&2
  exit 1
fi

declare -A stored=()
if [[ -f $MANIFEST ]]; then
  while IFS= read -r line; do
    [[ $line =~ ^\"([^\"]+)\"[[:space:]]*=[[:space:]]*\"(#[0-9A-Fa-f]{6})\"$ ]] || continue
    stored["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
  done <"$MANIFEST"
fi

mkdir -p "$BACKGROUND_DIR"
manifest="# Pre-stored wallpaper accents, applied instantly by r2-d2-theme-bg-set.
# Keys are file names inside backgrounds/. Values are named palette sources
# (config/theme/palette.toml) and may be hand-curated; keep the
# \"name.png\" = \"#RRGGBB\" line shape. Backfill or recompute with:
# r2-d2-theme-bg-accents [--refresh]
"

count=0
for image in "$BACKGROUND_DIR"/*; do
  [[ -f $image ]] || continue
  base="$(basename "$image")"
  [[ $base == "@background" ]] && continue
  extension="${image##*.}"
  extension="${extension,,}"
  case "$extension" in
  png | jpg | jpeg | gif | bmp | webp | ppm) ;;
  *) continue ;;
  esac

  accent="${stored[$base]:-}"
  if [[ $refresh == true || -z $accent ]]; then
    accent="$(r2-d2-theme-accent-from-bg --print-only --image "$image")"
  fi
  manifest+="\"$base\" = \"$accent\""$'\n'
  (( count += 1 ))
done

printf '%s' "$manifest" >"$MANIFEST"
echo "Stored accents for $count wallpaper(s) in ${MANIFEST#"$R2D2_ROOT"/}"
