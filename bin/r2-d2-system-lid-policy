#!/bin/bash

# Choose what an undocked lid close does: suspend, lock, or keep running.
# Docked lids stay awake so clamshell mode can keep the external screen on.
#
# Usage: r2-d2-system-lid-policy [suspend|lock|ignore|status]

set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/r2-d2"
STATE_FILE="$STATE_DIR/lid-policy"
DROPIN=/etc/systemd/logind.conf.d/r2-d2-lid.conf

usage() {
  echo "Usage: r2-d2-system-lid-policy [suspend|lock|ignore|status]" >&2
}

policy_label() {
  case $1 in
  suspend) echo "Closing the lid suspends." ;;
  lock) echo "Closing the lid locks. The machine stays on." ;;
  ignore) echo "Closing the lid leaves the machine running." ;;
  *) return 1 ;;
  esac
}

status() {
  if [[ -f $STATE_FILE ]]; then
    local policy
    policy=$(<"$STATE_FILE")
    case $policy in
    suspend | lock | ignore) echo "$policy" ;;
    *) echo unset ;;
    esac
  else
    echo unset
  fi
}

write_dropin() {
  local logind_value=$1
  local tmp

  tmp=$(mktemp)
  cat >"$tmp" <<EOF
# Managed by r2-d2-system-lid-policy.
# Lock is handled by r2-d2-system-lid-close, so logind only suspends or ignores.
# Docked lids stay awake for clamshell mode.
[Login]
HandleLidSwitch=$logind_value
HandleLidSwitchExternalPower=$logind_value
HandleLidSwitchDocked=ignore
EOF

  if ! sudo install -Dm644 "$tmp" "$DROPIN"; then
    rm -f "$tmp"
    echo "Could not write $DROPIN" >&2
    exit 1
  fi
  rm -f "$tmp"

  if ! sudo systemctl try-reload-or-restart systemd-logind; then
    echo "Wrote $DROPIN but systemd-logind did not restart. It applies on the next boot." >&2
  fi
}

action=${1:-status}

case $action in
status)
  status
  ;;
suspend | lock | ignore)
  if ! r2-d2-hw-laptop; then
    echo "This machine has no lid." >&2
    exit 1
  fi

  logind_value=ignore
  [[ $action == suspend ]] && logind_value=suspend
  write_dropin "$logind_value"

  mkdir -p "$STATE_DIR"
  printf '%s\n' "$action" >"$STATE_FILE"

  message=$(policy_label "$action")
  echo "$message"
  echo "With an external screen connected, the lid stays in clamshell and does not suspend."
  r2-d2-notification-send "Lid close" "$message"
  ;;
*)
  usage
  exit 1
  ;;
esac
