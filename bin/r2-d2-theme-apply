#!/bin/bash

# Render theme templates into the R2-D2 repo only ($R2D2_PATH/config and default/config).
# Live ~/.config/ is updated by r2-d2-update-sync-files, not by this script.
#
# The engine is matugen (Material You). r2-d2-theme-state builds the dark and
# light palettes, then fills every template in config/theme/matugen/config.toml
# from the document's dark roles. R2-D2 stays dark. The published document
# still carries both palettes.

set -euo pipefail

R2D2_ROOT="${R2D2_PATH:-$HOME/.local/share/r2-d2}"
STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/r2-d2/theme-accent"
if [[ ! -f $STATE_FILE && -f $HOME/.local/state/r2-d2/theme-accent ]]; then
  STATE_FILE="$HOME/.local/state/r2-d2/theme-accent"
fi

# Serialize repo rendering with explicit live syncs, not with the desktop itself.
exec 9>"$R2D2_ROOT/.theme.lock"
flock 9

usage() {
  echo "Usage: r2-d2-theme-apply [--accent #RRGGBB | --from-background | --from-state]" >&2
  exit 1
}

accent=""
mode=""

while [[ $# -gt 0 ]]; do
  case "$1" in
  --accent)
    [[ $# -ge 2 ]] || usage
    [[ -z $mode ]] || usage
    mode="accent"
    accent="${2^^}"
    shift 2
    ;;
  --from-background)
    [[ -z $mode ]] || usage
    mode="background"
    shift
    ;;
  --from-state)
    [[ -z $mode ]] || usage
    mode="state"
    shift
    ;;
  -h | --help) usage ;;
  *) usage ;;
  esac
done

if [[ -n $mode ]]; then
  case "$mode" in
    background) accent="$(r2-d2-theme-accent-from-bg --print-only)" ;;
  state)
    if [[ -f $STATE_FILE ]]; then
      accent="$(<"$STATE_FILE")"
    else
      accent="$(r2-d2-theme-accent-from-bg --print-only)"
    fi
    ;;
  esac
fi

if [[ -z $accent && $mode != "accent" ]]; then
  if [[ -f $STATE_FILE ]]; then
    accent="$(<"$STATE_FILE")"
  else
    accent="#FFFFFF"
  fi
fi

# Validate the source before changing any output. r2-d2-theme-state build
# normalizes and rejects anything that is not a full #RRGGBB token.
accent="${accent^^}"
pending="$(mktemp "$R2D2_ROOT/.theme-state.XXXXXX")"
trap 'rm -f "$pending"' EXIT

# Build (and validate) the document before touching the staged state. A failed
# validation must leave the previously staged document intact; only a render
# failure after a successful build clears the staged document.
"$R2D2_ROOT/bin/r2-d2-theme-state" build "$accent" >"$pending"

# A partial render must never leave an older document eligible for activation.
rm -f "$R2D2_ROOT/.theme-state.json"

# Fill templates from the document just built, so Black's dark override and
# the published colors cannot drift. Paths in config.toml resolve relative to
# the config file's own directory.
if ! "$R2D2_ROOT/bin/r2-d2-theme-state" render "$pending"; then
  echo "Theme render failed for accent $accent" >&2
  exit 1
fi

# Preserve user text size across theme/accent re-renders (repo templates only).
if [[ -x $R2D2_ROOT/bin/r2-d2-display-text-size ]]; then
  text_size_state="${XDG_STATE_HOME:-$HOME/.local/state}/r2-d2/display/text-size"
  if [[ -f $text_size_state ]]; then
    size=$(tr -d '[:space:]' <"$text_size_state")
    if [[ $size =~ ^[0-9]+$ ]]; then
      R2D2_TEXT_SIZE_CONFIG_ROOT="$R2D2_ROOT/config" "$R2D2_ROOT/bin/r2-d2-display-text-size" "$size" >/dev/null || true
    fi
  fi
fi

"$R2D2_ROOT/bin/r2-d2-theme-state" stage "$pending"

echo "Applied R2-D2 theme accent to repo: $accent"
