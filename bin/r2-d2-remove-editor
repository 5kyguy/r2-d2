#!/bin/bash

# Remove one editor installed from the R2-D2 menu, or Cursor from the default set.

if [[ -z $1 ]]; then
  echo "Usage: r2-d2-remove-editor <cursor|vscode|t3code|opencode|hermes>" >&2
  exit 1
fi

skip_aur_package() {
  local skip_file="$HOME/.local/state/r2-d2/skipped-aur-packages"
  mkdir -p "${skip_file%/*}"
  grep -qxF "$1" "$skip_file" 2>/dev/null || printf '%s\n' "$1" >>"$skip_file"
}

case "$1" in
cursor)
  echo -e "Removing Cursor...\n"
  skip_aur_package cursor-bin
  r2-d2-pkg-drop cursor-bin
  ;;
vscode)
  echo -e "Removing VS Code...\n"
  r2-d2-pkg-drop visual-studio-code-bin
  ;;
t3code)
  echo -e "Removing T3 Code...\n"
  r2-d2-pkg-drop t3code-bin
  ;;
opencode)
  echo -e "Removing OpenCode...\n"
  rm -rf "$HOME/.opencode"
  rm -f "$HOME/.local/bin/opencode"
  ;;
hermes)
  echo -e "Removing Hermes...\n"
  rm -f "$HOME/.local/bin/hermes"
  rm -rf "${HERMES_HOME:-$HOME/.hermes}"
  ;;
*)
  echo "Unknown editor: $1" >&2
  exit 1
  ;;
esac

echo -e "\nDone!"
