#!/bin/bash

# Install one of the supported editors. Usually called via Install > Editor in the R2-D2 Menu.

if [[ -z $1 ]]; then
  echo "Usage: r2-d2-install-editor <cursor|vscode|t3code|opencode|hermes>" >&2
  exit 1
fi

case "$1" in
cursor)
  echo -e "Installing Cursor...\n"
  skip_file="$HOME/.local/state/r2-d2/skipped-aur-packages"
  if [[ -f $skip_file ]]; then
    grep -vxF cursor-bin "$skip_file" >"$skip_file.tmp" || true
    mv "$skip_file.tmp" "$skip_file"
  fi
  r2-d2-pkg-aur-add cursor-bin
  ;;
vscode)
  echo -e "Installing VS Code...\n"
  r2-d2-pkg-aur-add visual-studio-code-bin
  ;;
t3code)
  echo -e "Installing T3 Code...\n"
  r2-d2-pkg-aur-add t3code-bin
  ;;
opencode)
  echo -e "Installing OpenCode...\n"
  bash "${R2D2_PATH:-$HOME/.local/share/r2-d2}/install/packaging/opencode.sh"
  ;;
hermes)
  echo -e "Installing Hermes...\n"
  bash "${R2D2_PATH:-$HOME/.local/share/r2-d2}/install/packaging/hermes.sh"
  ;;
*)
  echo "Unknown editor: $1" >&2
  exit 1
  ;;
esac
