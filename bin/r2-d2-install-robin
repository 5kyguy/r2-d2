#!/bin/bash

# Install or upgrade Robin from GitHub releases into ~/.local/bin.
# Robin is the R2-D2 file manager in progress; Thunar stays the default
# handler until a later migration flips inode/directory and Super+N.
# Stamps the release tag in the r2-d2 state dir, so re-running is a no-op
# when the newest release is already installed.

set -euo pipefail

repo=5kyguy/robin
bin="${HOME}/.local/bin/robin"
stamp="${XDG_STATE_HOME:-$HOME/.local/state}/r2-d2/robin-rev"

main() {
  local json tag name url sums dir

  json=$(curl -fsSL -A r2-d2 "https://api.github.com/repos/$repo/releases/latest") || {
    echo "Could not reach GitHub for Robin." >&2
    return 1
  }

  tag=$(jq -r .tag_name <<<"$json")
  name=$(jq -r '[.assets[].name | select(test("^robin-v.*\\.tar\\.gz$"))][0] // empty' <<<"$json")
  sums=$(jq -r '.assets[] | select(.name == "SHA256SUMS") | .browser_download_url' <<<"$json")
  url=$(jq -r --arg name "$name" '.assets[] | select(.name == $name) | .browser_download_url' <<<"$json")

  [[ -n $tag && $tag != "null" && -n $name && $name != "null" && -n $url && $url != "null" && -n $sums && $sums != "null" ]] || {
    echo "Robin release is missing a tarball or checksum." >&2
    return 1
  }

  if [[ -x $bin && -f $stamp && $(<"$stamp") == "$tag" ]]; then
    echo "robin $tag is already installed"
  else
    # PDF thumbnails shell out to pdftoppm; ffmpegthumbnailer is in the
    # base package list already.
    if r2-d2-pkg-missing poppler; then
      r2-d2-pkg-add poppler
    fi

    dir=$(mktemp -d)
    trap 'rm -rf "$dir"' RETURN

    curl -fL -A r2-d2 -o "$dir/$name" "$url"
    curl -fL -A r2-d2 -o "$dir/SHA256SUMS" "$sums"
    (cd "$dir" && sha256sum -c --ignore-missing SHA256SUMS | grep -F -- "$name: OK")

    tar -C "$dir" -xzf "$dir/$name"
    local top
    top=$(tar -tzf "$dir/$name" | head -1 | cut -d/ -f1)
    [[ -n $top && -x "$dir/$top/robin" ]] || {
      echo "Robin tarball does not contain a runnable robin binary." >&2
      return 1
    }
    install -Dm 755 "$dir/$top/robin" "$bin"

    mkdir -p "$(dirname "$stamp")"
    printf '%s\n' "$tag" >"$stamp"
  fi

  # Robin is the default file manager; Thunar stays installed as the fallback.
  if [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/applications/robin.desktop" ]]; then
    xdg-mime default robin.desktop inode/directory
  fi
}

main "$@"
