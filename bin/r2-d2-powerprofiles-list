#!/bin/bash

# Returns the available power profiles, one per line.
# With --active-state, each line is "<profile>\t<0|1>" so the power panel
# can mark the one powerprofilesctl currently has selected.

if [[ ${1:-} != "" && ${1:-} != "--active-state" ]]; then
  echo "Usage: r2-d2-powerprofiles-list [--active-state]" >&2
  exit 1
fi

powerprofilesctl list 2>/dev/null |
  awk -v with_state="${1:+1}" '/^\s*[* ]\s*[a-zA-Z0-9-]+:$/ {
    active = ($1 == "*") ? 1 : 0
    gsub(/^[*[:space:]]+|:$/, "")
    print $0 (with_state ? "\t" active : "")
  }' |
  tac
