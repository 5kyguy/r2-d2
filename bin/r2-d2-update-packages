#!/bin/bash

set -e

r2-d2-update-pacman-aur

echo -e "\e[32m\nUpdate Flatpaks\e[0m"

if r2-d2-cmd-missing flatpak; then
  echo "flatpak is not installed; skipping Flatpak updates."
else
  flatpak update -y
fi

echo -e "\e[32mUpdate Firmware\e[0m"

if r2-d2-cmd-missing fwupdmgr; then
  r2-d2-pkg-add fwupd
fi

fwupdmgr refresh --force
sudo fwupdmgr update
