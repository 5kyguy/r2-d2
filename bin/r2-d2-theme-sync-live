#!/bin/bash

# Copy theme-rendered repo config into the live session (~/.config/).
# Keep in sync with outputs from bin/r2-d2-theme-apply.

set -euo pipefail

R2D2_PATH="${R2D2_PATH:-$HOME/.local/share/r2-d2}"

exec 9>"$R2D2_PATH/.theme.lock"
flock 9
"$R2D2_PATH/bin/r2-d2-theme-state" check

# Copying looknfeel.lua reloads Hyprland and can move focus onto a new workspace.
"$R2D2_PATH/bin/r2-d2-hyprland-monitors-restore" --remember-workspace || true

declare -a THEME_PATHS=(
  config/hypr/looknfeel.lua
  config/hypr/hyprlock.conf
  config/waybar/waybar.css
  config/waybar/style.css
  config/gtk-3.0/gtk.css
  config/alacritty/alacritty.toml
  config/mako/config
  config/swayosd/style.css
  config/btop/themes/current.theme
  config/starship.toml
)

for relative_path in "${THEME_PATHS[@]}"; do
  src="$R2D2_PATH/$relative_path"
  dest="$HOME/.config/${relative_path#config/}"

  [[ -f $src ]] || continue
  mkdir -p "$(dirname "$dest")"
  cp -T "$src" "$dest"
done

mkdir -p ~/.config/walker/themes/default
cp -T "$R2D2_PATH/default/config/walker/themes/default/style.css" ~/.config/walker/themes/default/style.css

mkdir -p ~/.config/hyprland-preview-share-picker
cp -T "$R2D2_PATH/default/config/hyprland-preview-share-picker/style.css" ~/.config/hyprland-preview-share-picker/style.css

# Announce the selected configuration only after every copy succeeds.
"$R2D2_PATH/bin/r2-d2-theme-state" activate

if [[ -f "$R2D2_PATH/bin/r2-d2-theme-publish" ]]; then
  "$R2D2_PATH/bin/r2-d2-theme-publish" || true
fi
