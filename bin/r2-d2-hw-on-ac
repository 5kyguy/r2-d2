#!/bin/bash

# Exit 0 when any Mains power supply is online (the machine is on AC), 1
# otherwise. For use in conditionals: r2-d2-hw-on-ac && echo plugged in

for supply in /sys/class/power_supply/*; do
  [[ -r $supply/type ]] || continue
  [[ $(<"$supply/type") == "Mains" ]] || continue
  [[ -r $supply/online ]] || continue
  [[ $(<"$supply/online") == "1" ]] && exit 0
done
exit 1
