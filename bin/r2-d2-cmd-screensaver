#!/bin/bash

# Run the R2-D2 screensaver. One pattern is chosen when it starts and repeats until wake.

screensaver_in_focus() {
  hyprctl activewindow -j | jq -e '.class == "org.r2d2.screensaver"' >/dev/null 2>&1
}

exit_screensaver() {
  hyprctl eval 'hl.config({ cursor = { invisible = false } })' &>/dev/null || true
  pkill -x tte 2>/dev/null
  pkill -f org.r2d2.screensaver 2>/dev/null
  exit 0
}

# Exit the screensaver on signals and input from keyboard and mouse
trap exit_screensaver SIGINT SIGTERM SIGHUP SIGQUIT

printf '\033]11;rgb:00/00/00\007' # Set background color to black

hyprctl eval 'hl.config({ cursor = { invisible = true } })' &>/dev/null

tty=$(tty 2>/dev/null)

play() {
  tte -i ~/.config/r2-d2/branding/screensaver.txt \
    --frame-rate 120 --canvas-width 0 --canvas-height 0 --reuse-canvas --anchor-canvas c --anchor-text c \
    --no-eol --no-restore-cursor \
    "$@" &

  while pgrep -t "${tty#/dev/}" -x tte >/dev/null; do
    if read -n1 -t 1 || ! screensaver_in_focus; then
      exit_screensaver
    fi
  done
}

# Pick once. Waking the machine is what starts a new choice.
if (( RANDOM % 2 == 0 )); then
  effect=matrix
else
  effect=laseretch
fi

while true; do
  play "$effect"
done
