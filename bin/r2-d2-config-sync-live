#!/bin/bash

# Copy all repo user config into the live session (~/.config/).
# Cursor, VS Code, and OpenCode user files are not replaced. The accent merge
# updates Cursor color keys only.

set -euo pipefail

R2D2_PATH="${R2D2_PATH:-$HOME/.local/share/r2-d2}"

exec 9>"$R2D2_PATH/.theme.lock"
flock 9
"$R2D2_PATH/bin/r2-d2-theme-state" check

# Copying Hyprland config reloads the session and can move focus onto a new workspace.
"$R2D2_PATH/bin/r2-d2-hyprland-monitors-restore" --remember-workspace || true

mkdir -p ~/.config

for item in "$R2D2_PATH"/config/*; do
  name=$(basename "$item")

  if [[ $name == Cursor || $name == Code || $name == opencode ]]; then
    continue
  fi

  cp -R "$item" ~/.config/
done

mkdir -p ~/.config/walker/themes/default
cp -T "$R2D2_PATH/default/config/walker/themes/default/style.css" ~/.config/walker/themes/default/style.css

mkdir -p ~/.config/hyprland-preview-share-picker
cp -T "$R2D2_PATH/default/config/hyprland-preview-share-picker/style.css" ~/.config/hyprland-preview-share-picker/style.css

"$R2D2_PATH/bin/r2-d2-theme-accent-apps"

"$R2D2_PATH/bin/r2-d2-theme-state" activate

if [[ -f "$R2D2_PATH/bin/r2-d2-theme-publish" ]]; then
  "$R2D2_PATH/bin/r2-d2-theme-publish" || true
fi
