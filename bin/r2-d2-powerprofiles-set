#!/bin/bash

# Set and remember the power profile for AC or battery use.
# Usage: r2-d2-powerprofiles-set [autodetect|ac|battery] [power-saver|balanced|performance]
#
# With no argument (or "autodetect"), scan /sys/class/power_supply for any
# Mains OR USB device reporting online=1 and treat that as "on AC". This
# handles USB-C-only laptops (like the HP ZBook Ultra G1a) where the legacy
# AC device may not exist or may not fire udev events on plug/unplug.
# Port of omarchy powerprofiles persistence + R2 sysfs autodetect.

action="${1:-autodetect}"
requested_profile="${2:-}"

usage() {
  echo "Usage: r2-d2-powerprofiles-set [autodetect|ac|battery] [power-saver|balanced|performance]" >&2
  exit 1
}

(($# <= 2)) || usage

case "$action" in
autodetect)
  # On plug/unplug, udev fires the rule before sysfs `online` is updated on
  # some laptops. A short settle delay lets the kernel update before we read.
  sleep 0.3

  action=battery
  for ps in /sys/class/power_supply/*; do
    [[ -r $ps/online && -r $ps/type ]] || continue
    type=$(cat "$ps/type")
    [[ $type == "Mains" || $type == "USB" ]] || continue
    if [[ $(cat "$ps/online") == "1" ]]; then
      action=ac
      break
    fi
  done
  ;;
ac | battery) ;;
*) usage ;;
esac

mapfile -t profiles < <(r2-d2-powerprofiles-list)

profile_available() {
  [[ " ${profiles[*]} " == *" $1 "* ]]
}

state_dir="${R2D2_POWERPROFILES_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/r2-d2/powerprofiles}"
state_file="$state_dir/$action"

if [[ -n $requested_profile ]]; then
  profile_available "$requested_profile" || {
    echo "Power profile is not available: $requested_profile" >&2
    exit 1
  }

  profile="$requested_profile"
elif [[ -r $state_file ]]; then
  profile=$(<"$state_file")
fi

if [[ -z ${profile:-} ]] || ! profile_available "$profile"; then
  if [[ $action == "ac" ]] && profile_available performance; then
    profile=performance
  else
    profile=balanced
  fi
fi

powerprofilesctl set "$profile" || exit

if [[ -n $requested_profile ]]; then
  mkdir -p "$state_dir"
  printf '%s\n' "$requested_profile" >"$state_file"
fi
