#!/bin/bash

# Provision Voxtype once: small.en, the user service, and GPU when Vulkan exists.
# Later model changes live in ~/.config/voxtype and are not reset.

set -euo pipefail

if r2-d2-cmd-missing voxtype; then
  exit 0
fi

R2D2_PATH="${R2D2_PATH:-$HOME/.local/share/r2-d2}"
marker="$HOME/.local/state/r2-d2/voxtype-provisioned"

mkdir -p ~/.config/voxtype "$HOME/.local/state/r2-d2"
if [[ ! -f ~/.config/voxtype/config.toml ]]; then
  cp "$R2D2_PATH/config/voxtype/config.toml" ~/.config/voxtype/config.toml
fi

if [[ -f $marker ]]; then
  exit 0
fi

current=$(voxtype config get whisper.model 2>/dev/null | tr -d '[:space:]' || true)

# The whisper model (~465 MB for small.en) is a single curl download whose
# carriage-return progress bar never shows up in the install log, so say what
# is happening. Bound it too — a stalled huggingface.co connection would hang
# the install forever otherwise.
echo "Downloading the whisper model (~465 MB) — this can take a while..."
download_timeout=900

download_failed=0
if [[ -z $current || $current == "base.en" ]]; then
  timeout "$download_timeout" voxtype setup --download --model small.en --activate --no-post-install || download_failed=1
else
  timeout "$download_timeout" voxtype setup --download --model "$current" --no-post-install || download_failed=1
fi

if (( download_failed )); then
  echo "Whisper model download failed or timed out — skipping voxtype provisioning; it retries on the next r2-d2-update." >&2
  exit 0
fi

if r2-d2-hw-vulkan; then
  voxtype setup gpu --enable || true
fi

voxtype setup systemd
systemctl --user restart voxtype.service || true

touch "$marker"
