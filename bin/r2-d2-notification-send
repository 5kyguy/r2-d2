#!/bin/bash

# Send an R2-D2 desktop notification with optional glyph, image, and click
# action support. Uses busctl so relayed headlines cannot become options.
#
# Usage:
#   r2-d2-notification-send [-a] [--app-name <name>] [-g <glyph>] \
#     [-u <low|normal|critical>] [--image <path-or-uri>] [-t <ms>] [-i <icon>] \
#     [-r <id>] [-p] <headline> [description]
#
# -a / --action     register a default click action; echoes "default" if clicked
# -g / --glyph      nerd-font glyph (hint: r2-d2-glyph)
# --image           image thumbnail (hint: image-path)
# --app-name        override app-name (default: r2-d2-action)
# -u / --urgency    low|normal|critical (default: low)
# -t / --expire-time  milliseconds (-1 default; 0 = no expire)
# -p / --print-id   print the notification id
#
# Port of omarchy-notification-send (busctl) with mako-compatible -a wait.

set -euo pipefail

headline=""
description=""
glyph=
urgency="low"
app_name="r2-d2-action"
app_icon=""
image=
expire_timeout=-1
replaces_id=0
print_id=0
click_action=0
parsed_option_args=0

usage() {
  echo "Usage: r2-d2-notification-send [-a] [--app-name <name>] [-g <glyph>] [-u <low|normal|critical>] [--image <path-or-uri>] [-t <ms>] [-i <icon>] [-r <id>] [-p] <headline> [description]" >&2
}

parse_r2d2_option() {
  local opt val nargs
  if [[ $1 == --?*=* ]]; then
    opt=${1%%=*}
    val=${1#*=}
    nargs=1
  else
    opt=$1
    val=${2-}
    nargs=2
  fi

  if [[ $opt == -p || $opt == --print-id ]]; then
    print_id=1
    parsed_option_args=1
    return 0
  fi

  if [[ $opt == -a || $opt == --action ]]; then
    click_action=1
    parsed_option_args=1
    return 0
  fi

  case $opt in
  -g | --glyph | -u | --urgency | --app-name | -i | --icon | --image | -r | --replace-id | -t | --expire-time) ;;
  *) return 1 ;;
  esac

  if ((nargs == 2)) && (($# < 2)); then
    echo "Missing value for $opt" >&2
    exit 1
  fi

  case $opt in
  -g | --glyph) glyph=$val ;;
  -u | --urgency) urgency=$val ;;
  --app-name) app_name=$val ;;
  -i | --icon) app_icon=$val ;;
  --image) image=$val ;;
  -r | --replace-id)
    [[ $val =~ ^[0-9]+$ ]] || {
      echo "Invalid $opt value (numeric id expected): $val" >&2
      exit 1
    }
    replaces_id=$val
    ;;
  -t | --expire-time)
    [[ $val =~ ^-?[0-9]+$ ]] || {
      echo "Invalid $opt value (milliseconds expected): $val" >&2
      exit 1
    }
    expire_timeout=$val
    ;;
  esac

  parsed_option_args=$nargs
  return 0
}

while (($# > 0)); do
  if parse_r2d2_option "$@"; then
    shift "$parsed_option_args"
  else
    break
  fi
done

if (($# < 1)); then
  usage
  exit 1
fi

headline=$1
shift

known_flag() {
  case $1 in
  -g | --glyph | -u | --urgency | --app-name | -i | --icon | -t | --expire-time | --image | -r | --replace-id | -p | --print-id | -a | --action) return 0 ;;
  --glyph=* | --urgency=* | --app-name=* | --icon=* | --expire-time=* | --image=* | --replace-id=*) return 0 ;;
  esac
  return 1
}

# Description is the next positional even when it begins with a dash.
if (($# > 0)) && ! known_flag "$1"; then
  description=$1
  shift
fi

while (($# > 0)); do
  if parse_r2d2_option "$@"; then
    shift "$parsed_option_args"
  else
    echo "Unknown option: $1" >&2
    usage
    exit 1
  fi
done

case $urgency in
low) urgency_byte=0 ;;
normal) urgency_byte=1 ;;
critical) urgency_byte=2 ;;
*)
  echo "Unknown urgency: $urgency (use low, normal, or critical)" >&2
  exit 1
  ;;
esac

hints=(urgency y "$urgency_byte")

if [[ -n $glyph ]]; then
  hints+=(r2-d2-glyph s "$glyph")
fi

if [[ -n $image ]]; then
  hints+=(image-path s "$image")
fi

hint_count=$((${#hints[@]} / 3))

# actions: empty, or ["default","default"] for clickable -a
if ((click_action)); then
  action_count=2
  action_args=(default default)
else
  action_count=0
  action_args=()
fi

notify_cmd=(
  busctl --user -- call
  org.freedesktop.Notifications /org/freedesktop/Notifications
  org.freedesktop.Notifications Notify susssasa{sv}i
  "$app_name" "$replaces_id" "$app_icon" "$headline" "$description"
  "$action_count" "${action_args[@]}"
  "$hint_count" "${hints[@]}"
  "$expire_timeout"
)

out=$("${notify_cmd[@]}")
nid="${out##* }"

if ((print_id)) && ((!click_action)); then
  printf '%s\n' "$nid"
fi

if ((!click_action)); then
  exit 0
fi

# Wait for ActionInvoked on this notification id (mako click / dismiss).
wait_timeout_s=30
if ((expire_timeout == 0)); then
  wait_timeout_s=3600
elif ((expire_timeout > 0)); then
  wait_timeout_s=$((expire_timeout / 1000 + 2))
fi

action=$(
  timeout "$wait_timeout_s" dbus-monitor --session \
    "type='signal',interface='org.freedesktop.Notifications',member='ActionInvoked'" \
    2>/dev/null |
    awk -v want="$nid" '
      /member=ActionInvoked/ { pending=1; next }
      pending && /uint32/ {
        id=$NF
        gsub(/[^0-9]/, "", id)
        if (id == want) { need_key=1 }
        pending=0
        next
      }
      need_key && /string/ {
        key=$0
        sub(/^.*string[[:space:]]+"?/, "", key)
        sub(/"?[[:space:]]*$/, "", key)
        print key
        exit
      }
    '
) || true

if [[ $action == "default" ]]; then
  echo default
fi
