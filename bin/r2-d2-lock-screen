#!/bin/bash

# Locks the system using the shell lock, but not before ensuring 1password has also been locked, and the screensaver stopped.

hyprctl switchxkblayout all 0 >/dev/null 2>&1

if pgrep -x "1password" >/dev/null; then
  1password --lock &
fi

pkill -f org.r2d2.screensaver

r2-d2-shell lock lock
