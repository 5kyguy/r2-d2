#!/bin/bash

# Diagnose a crashed process with K-2SO (async ask).
# Usage: r2-d2-k2so-crash <pid> [comm] [exe] [signal]

set -euo pipefail

pid=${1:?usage: r2-d2-k2so-crash <pid> [comm] [exe] [signal]}

if [[ ! $pid =~ ^[0-9]+$ ]]; then
  echo "Not a PID: $pid" >&2
  echo "Usage: r2-d2-k2so-crash <pid>   (see: coredumpctl list)" >&2
  exit 1
fi

if ! command -v k2so >/dev/null 2>&1; then
  echo "k2so is not installed" >&2
  exit 1
fi

if ! systemctl --user is-active --quiet k2so.service 2>/dev/null; then
  echo "k2so.service is not active" >&2
  exit 1
fi

comm=${2:-unknown}
exe=${3:-unknown}
signal=${4:-unknown}

R2D2_PATH="${R2D2_PATH:-$HOME/.local/share/r2-d2}"
skill="$R2D2_PATH/config/k2so/skills/diagnose-crash/SKILL.md"

when=$(coredumpctl list "$pid" --no-pager --no-legend 2>/dev/null | tail -1 | cut -d' ' -f1-4) || true
when=${when:-unknown}

prompt=$(
  cat <<PROMPT
A process crashed on this R2-D2 machine and I want to know why.

What systemd-coredump recorded:
  process:  $comm
  PID:      $pid
  binary:   $exe
  signal:   $signal
  time:     $when

Use the diagnose-crash skill: it covers how to investigate, what to report, and
when a crash is worth reporting upstream to R2-D2. If your harness has no skill
mechanism, read the skill files directly and follow them instead:

  $skill
PROMPT
)

exec k2so ask --type crash-diagnosis "$prompt"
