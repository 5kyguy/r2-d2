#!/bin/bash

# Open the URL as an app window in the default browser. Brave Origin is that
# default. Chromium is only the spare when the default browser has no --app flag.

browser=$(xdg-settings get default-web-browser)

case $browser in
google-chrome* | brave-browser* | brave-origin* | microsoft-edge* | opera* | vivaldi*) ;;
*) browser="chromium.desktop" ;;
esac

exec setsid uwsm-app -- "$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' {~/.local,~/.nix-profile,/usr}/share/applications/$browser 2>/dev/null | head -1)" --app="$1" "${@:2}"
