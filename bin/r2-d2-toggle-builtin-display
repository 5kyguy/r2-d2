#!/bin/bash
# Toggle built-in (eDP) display on/off. Session-only: resets to normal on reboot.
#
# Usage: r2-d2-toggle-builtin-display [enable|disable|toggle]
#   enable / disable — explicit (used by lid switch)
#   toggle (default) — Super+Shift+D

set -e

STATE_FILE="$HOME/.local/state/r2-d2/toggles/builtin-display-disabled"
ACTION="${1:-toggle}"

get_builtin_monitor() {
  # Include disabled outputs so we can re-enable after lid close / hotkey.
  hyprctl monitors all -j 2>/dev/null | jq -r '.[] | select(.name | test("eDP"; "i")) | .name' | head -1
}

builtin_is_disabled() {
  local name=$1
  [[ -f $STATE_FILE ]] && return 0
  hyprctl monitors all -j 2>/dev/null |
    jq -e --arg n "$name" '.[] | select(.name == $n and .disabled == true)' >/dev/null
}

enable_builtin() {
  local name=$1
  r2-d2-hyprland-monitor-set "$name" preferred auto 1
  rm -f "$STATE_FILE"
  notify-send "Built-in display enabled" "Monitor $name is on"
}

disable_builtin() {
  local name=$1
  local count

  count=$(hyprctl monitors -j 2>/dev/null | jq 'length')
  if ((count < 2)); then
    notify-send "Built-in display" "Connect an external monitor first. Disabling the only display would freeze the session."
    exit 1
  fi

  mkdir -p "$(dirname "$STATE_FILE")"
  echo "$name" >"$STATE_FILE"
  r2-d2-hyprland-monitor-set "$name" disable
  notify-send "Built-in display disabled" "Monitor $name is off until reboot"
}

name=$(get_builtin_monitor)
if [[ -z $name ]]; then
  notify-send "Built-in display" "No built-in (eDP) monitor found"
  exit 1
fi

case "$ACTION" in
enable)
  enable_builtin "$name"
  ;;
disable)
  disable_builtin "$name"
  ;;
toggle)
  if builtin_is_disabled "$name"; then
    enable_builtin "$name"
  else
    disable_builtin "$name"
  fi
  ;;
*)
  echo "Usage: r2-d2-toggle-builtin-display [enable|disable|toggle]" >&2
  exit 1
  ;;
esac
