#!/bin/bash
# Toggle built-in (eDP/LVDS/DSI) display on/off. Session-only: resets to normal on reboot.
#
# Usage: r2-d2-toggle-builtin-display [enable|disable|toggle]
#   enable / disable — explicit (used by hotkey; lid uses clamshell orchestrator)
#   toggle (default) — Super+Shift+D

set -e

TOGGLES_DIR="$HOME/.local/state/r2-d2/toggles"
STATE_FILE="$TOGGLES_DIR/builtin-display-disabled"
CLAMSHELL_FLAG="$TOGGLES_DIR/builtin-display-clamshell"
SCALE_STATE="$TOGGLES_DIR/internal-monitor-scale"
ACTION="${1:-toggle}"

valid_scale() {
  [[ $1 =~ ^[0-9]+([.][0-9]+)?$ ]]
}

get_builtin_monitor() {
  r2-d2-hyprland-monitor-laptop
}

remember_scale() {
  local name=$1
  local scale
  scale=$(hyprctl monitors all -j 2>/dev/null | jq -r --arg n "$name" '.[] | select(.name == $n and .disabled != true) | .scale' | head -1)
  if valid_scale "$scale"; then
    mkdir -p "$TOGGLES_DIR"
    printf '%s\n' "$scale" >"$SCALE_STATE"
  fi
}

read_scale() {
  local scale=""
  if [[ -f $SCALE_STATE ]]; then
    scale=$(<"$SCALE_STATE")
    valid_scale "$scale" && {
      echo "$scale"
      return
    }
  fi
  echo 1
}

builtin_is_disabled() {
  local name=$1
  [[ -f $STATE_FILE || -f $CLAMSHELL_FLAG ]] && return 0
  hyprctl monitors all -j 2>/dev/null |
    jq -e --arg n "$name" '.[] | select(.name == $n and .disabled == true)' >/dev/null
}

enable_builtin() {
  local name=$1
  local scale
  scale=$(read_scale)
  r2-d2-hyprland-monitor-set "$name" preferred auto "$scale"
  rm -f "$STATE_FILE" "$CLAMSHELL_FLAG"
  hyprctl dispatch "hl.dsp.dpms({ action = \"enable\", monitor = \"$name\" })" >/dev/null 2>&1 || true
  r2-d2-notification-send "Built-in display enabled" "Monitor $name is on"
}

disable_builtin() {
  local name=$1
  local count

  count=$(hyprctl monitors -j 2>/dev/null | jq 'length')
  if ((count < 2)); then
    r2-d2-notification-send "Built-in display" "Connect an external monitor first. Disabling the only display would freeze the session."
    exit 1
  fi

  mkdir -p "$TOGGLES_DIR"
  remember_scale "$name"
  echo "$name" >"$STATE_FILE"
  r2-d2-hyprland-monitor-set "$name" disable
  r2-d2-notification-send "Built-in display disabled" "Monitor $name is off until reboot"
}

name=$(get_builtin_monitor)
if [[ -z $name ]]; then
  r2-d2-notification-send "Built-in display" "No built-in (eDP/LVDS/DSI) monitor found"
  exit 1
fi

case "$ACTION" in
enable)
  enable_builtin "$name"
  ;;
disable)
  disable_builtin "$name"
  ;;
toggle)
  if builtin_is_disabled "$name"; then
    enable_builtin "$name"
  else
    disable_builtin "$name"
  fi
  ;;
*)
  echo "Usage: r2-d2-toggle-builtin-display [enable|disable|toggle]" >&2
  exit 1
  ;;
esac
