#!/bin/bash

# Returns true when running on a laptop (has a lid or laptop chassis).
# Port of omarchy-hw-laptop.

for state in /proc/acpi/button/lid/*/state; do
  [[ -e $state ]] && exit 0
done

# 8=Portable 9=Laptop 10=Notebook 14=Sub Notebook 30=Tablet
# 31=Convertible 32=Detachable.
case $(</sys/class/dmi/id/chassis_type 2>/dev/null) in
8 | 9 | 10 | 14 | 30 | 31 | 32) exit 0 ;;
esac

exit 1
