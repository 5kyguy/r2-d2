#!/bin/bash

# Restore monitor layout after hyprctl reload (session tweaks live in runtime eval, not monitors.lua).

set -euo pipefail

TOGGLES_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/r2-d2/toggles"
WORKSPACE_HOLD="$TOGGLES_DIR/workspace-hold"

remember_workspace() {
  local id

  id=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty' 2>/dev/null || true)
  [[ $id =~ ^-?[0-9]+$ ]] || return 0
  mkdir -p "$TOGGLES_DIR"
  printf '%s %s\n' "$(date +%s)" "$id" >"$WORKSPACE_HOLD"
}

restore_workspace() {
  local saved_at id now active stable

  [[ -f $WORKSPACE_HOLD ]] || return 0
  read -r saved_at id <"$WORKSPACE_HOLD" || return 0
  [[ $saved_at =~ ^[0-9]+$ && $id =~ ^-?[0-9]+$ ]] || return 0
  now=$(date +%s)
  if ((now - saved_at > 30)); then
    rm -f "$WORKSPACE_HOLD"
    return 0
  fi

  # Disabling the laptop panel moves focus after hyprctl returns. Hyprland
  # then plugs the numeric gap with the lowest missing workspace, which is 3
  # whenever 1 and 2 already exist. That focus change can land after the first
  # successful restore, so wait until the saved workspace has held.
  stable=0
  for _ in {1..30}; do
    active=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty' || true)
    if [[ $active == "$id" ]]; then
      stable=$((stable + 1))
      if ((stable >= 8)); then
        rm -f "$WORKSPACE_HOLD"
        return 0
      fi
    else
      stable=0
      hyprctl dispatch "hl.dsp.focus({ workspace = $id })" >/dev/null 2>&1 || true
    fi
    sleep 0.1
  done
}

if [[ ${1:-} == "--remember-workspace" ]]; then
  remember_workspace
  exit 0
fi

if [[ ${1:-} == "--restore-workspace" ]]; then
  restore_workspace
  exit 0
fi
BUILTIN_DISABLED="$TOGGLES_DIR/builtin-display-disabled"
BUILTIN_CLAMSHELL="$TOGGLES_DIR/builtin-display-clamshell"
DISPLAY_MIRROR="$TOGGLES_DIR/display-mirror"

apply_mirror() {
  local monitors_json builtin external

  monitors_json=$(hyprctl monitors -j 2>/dev/null) || return 0
  builtin=$(echo "$monitors_json" | jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-")) | .name' | head -1)
  external=$(echo "$monitors_json" | jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not) | .name' | head -1)

  if [[ -n $builtin && -n $external ]]; then
    r2-d2-hyprland-monitor-set "$external" preferred 0x0 1 mirror "$builtin"
  fi
}

if [[ -f $BUILTIN_DISABLED ]]; then
  r2-d2-hyprland-monitor-set "$(cat "$BUILTIN_DISABLED")" disable
elif [[ -f $BUILTIN_CLAMSHELL ]]; then
  r2-d2-hyprland-monitor-set "$(cat "$BUILTIN_CLAMSHELL")" disable
elif [[ -f $DISPLAY_MIRROR ]]; then
  apply_mirror
elif [[ ${1:-} != "--flags-only" && ${1:-} != "--after-reload" && ! -t 0 ]]; then
  while read -r rule; do
    [[ -z $rule ]] && continue
    # Saved rules look like: name,WxH@Hz,XxY,scale
    IFS=',' read -r name mode position scale <<<"$rule"
    [[ -n $name && -n $mode && -n $position && -n $scale ]] || continue
    r2-d2-hyprland-monitor-set "$name" "$mode" "$position" "$scale"
  done
fi

# Workspace restore is a separate step. config.reloaded runs it after the
# monitor layout is reapplied, so a modeset cannot undo the saved workspace.
