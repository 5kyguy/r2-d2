#!/bin/bash

# Internal theme-document helper. Callers hold .theme.lock across render/sync.
# Builds the v3 skyguy-visual theme document from the fixed palette in
# config/theme/palette.toml. The document carries the named source accent, the
# scheme (fixed or monochrome), and the dark+light role set, plus a SHA-256
# revision over the canonical body. The portfolio worker validates that
# revision without re-deriving the palette.

set -euo pipefail

export R2D2_PATH="${R2D2_PATH:-$HOME/.local/share/r2-d2}"

python3 - "$@" <<'PY'
import colorsys
import hashlib
import json
import os
import re
import sys
import tempfile
import tomllib
from pathlib import Path

root = Path(os.environ['R2D2_PATH'])
state = Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state') / 'r2-d2'
palette_file = root / 'config/theme/palette.toml'
template_config = root / 'config/theme/templates.toml'

ROLES = [
    'accent', 'on_accent', 'deep', 'spark', 'on_spark',
    'bg', 'surface', 'text', 'muted', 'line',
    'danger', 'on_danger', 'warning', 'on_warning',
]
DARK_OWN = [
    'accent', 'on_accent', 'deep', 'spark', 'on_spark',
    'bg', 'surface', 'text', 'muted', 'line',
]
LIGHT_OWN = ['accent', 'on_accent', 'deep', 'spark', 'on_spark', 'line']
SIGNALS = ['danger', 'on_danger', 'warning', 'on_warning']
LIGHT_SHARED = ['bg', 'surface', 'text', 'muted']

# Rendered outputs that must exist before a live sync copies anything. These
# are the repo paths produced by r2-d2-theme-apply.
REQUIRED_OUTPUTS = [
    'config/hypr/looknfeel.lua',
    'config/r2-d2/colors.toml', 'config/r2-d2/shell.toml',
    'config/gtk-3.0/gtk.css', 'config/gtk-4.0/gtk.css',
    'config/alacritty/alacritty.toml', 'config/btop/themes/current.theme',
    'config/starship.toml', 'config/zathura/zathurarc',
    'default/config/walker/themes/default/style.css',
    'default/config/hyprland-preview-share-picker/style.css',
    'default/sddm/r2-d2/Palette.qml',
]


PLACEHOLDER = re.compile(
    r'\{\{colors\.([A-Za-z0-9_]+)\.default\.(hex|hex_stripped|red|green|blue)\}\}'
)


def normalize_hex(value):
    if not isinstance(value, str) or not re.fullmatch(r'#[0-9a-fA-F]{6}', value):
        raise ValueError(f'Expected a full #RRGGBB color, got {value!r}')
    return value.upper()


def hue_of(hex_color):
    red, green, blue = (int(hex_color[index:index + 2], 16) / 255 for index in (1, 3, 5))
    hue, saturation, value = colorsys.rgb_to_hsv(red, green, blue)
    return hue * 360, saturation, value


def hue_distance(left, right):
    delta = abs(left - right) % 360
    return min(delta, 360 - delta)


def load_palette():
    """Return {SOURCE: (scheme, dark, light, name)} from palette.toml."""
    with palette_file.open('rb') as handle:
        table = tomllib.load(handle)
    signals = {role: normalize_hex(table[role]) for role in SIGNALS}
    shared_light = {role: normalize_hex(table['light'][role]) for role in LIGHT_SHARED}
    accents = {}
    for name, item in table['accents'].items():
        source = normalize_hex(item['source'])
        scheme = item['scheme']
        if scheme not in ('fixed', 'monochrome'):
            raise ValueError(f'Accent {name} has unknown scheme {scheme!r}')
        dark = {role: normalize_hex(item['dark'][role]) for role in DARK_OWN}
        light = {role: normalize_hex(item['light'][role]) for role in LIGHT_OWN}
        dark.update(signals)
        light.update(signals)
        light.update(shared_light)
        if set(dark) != set(ROLES) or set(light) != set(ROLES):
            raise ValueError(f'Accent {name} is missing roles')
        accents[source] = (scheme, dark, light, name)
    names = {item[3] for item in accents.values()}
    if 'black' not in names or 'white' not in names:
        raise ValueError('Palette is missing black or white')
    return accents


def snap(source, accents):
    """Map any #RRGGBB onto a named source. Named sources pass through."""
    if source in accents:
        return source
    black = white = None
    chromatic = []
    for named, (scheme, _dark, _light, name) in accents.items():
        if scheme == 'monochrome':
            if name == 'black':
                black = named
            elif name == 'white':
                white = named
        else:
            chromatic.append((named, hue_of(named)[0]))
    hue, saturation, _value = hue_of(source)
    if saturation < 0.15:
        red, green, blue = (int(source[index:index + 2], 16) / 255 for index in (1, 3, 5))
        luminance = 0.2126 * red + 0.7152 * green + 0.0722 * blue
        return white if luminance >= 0.45 else black
    return min(chromatic, key=lambda item: hue_distance(hue, item[1]))[0]


def document(source):
    source = snap(normalize_hex(source), load_palette())
    scheme, dark, light, _name = load_palette()[source]
    data = {
        'version': 3,
        'contract': 'skyguy-visual',
        'contract_version': 3,
        'source': source,
        'scheme': scheme,
        'colors': {'dark': dark, 'light': light},
    }
    body = json.dumps(data, sort_keys=True, separators=(',', ':')).encode()
    data['revision'] = hashlib.sha256(body).hexdigest()
    return data


def load(path):
    if path.stat().st_size > 32768:
        raise ValueError('Theme document exceeds 32 KiB')
    data = json.loads(path.read_text())
    expected = document(data['source'])
    if json.dumps(data, sort_keys=True) != json.dumps(expected, sort_keys=True):
        raise ValueError('Invalid theme schema, colors, or revision')
    return data


def color_field(hex_color, kind):
    if kind == 'hex':
        return hex_color.lower()
    if kind == 'hex_stripped':
        return hex_color[1:].lower()
    offset = {'red': 1, 'green': 3, 'blue': 5}[kind]
    return str(int(hex_color[offset:offset + 2], 16))


def render_templates(data):
    """Fill templates from the document's dark roles."""
    dark = data['colors']['dark']
    for role in ROLES:
        normalize_hex(dark[role])
    config = tomllib.loads(template_config.read_text())
    base = template_config.parent
    repo = root.resolve()
    for spec in config['templates'].values():
        template = (base / spec['input_path']).read_text()

        def replace(match, colors=dark):
            role, kind = match.group(1), match.group(2)
            if role not in colors:
                raise ValueError(f'Template role not in document: {role}')
            return color_field(colors[role], kind)

        rendered = PLACEHOLDER.sub(replace, template)
        if '{{' in rendered:
            raise ValueError(f'Unrendered placeholder in {spec["input_path"]}')
        output = (base / spec['output_path']).resolve()
        if not output.is_relative_to(repo):
            raise ValueError(f'Template output escapes the repo: {output}')
        output.parent.mkdir(parents=True, exist_ok=True)
        output.write_text(rendered)


def atomic_write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_file() and path.read_text() == content:
        return
    fd, temporary = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


try:
    command, *args = sys.argv[1:]
    if command == 'build' and len(args) == 1:
        print(json.dumps(document(args[0]), sort_keys=True, indent=2))
    elif command == 'render' and len(args) == 1:
        render_templates(json.loads(Path(args[0]).read_text()))
    elif command == 'stage' and len(args) == 1:
        data = load(Path(args[0]))
        atomic_write(root / '.theme-state.json', json.dumps(data, sort_keys=True, indent=2) + '\n')
        atomic_write(state / 'theme-accent', data['source'] + '\n')
    elif command in ('check', 'activate') and not args:
        data = load(root / '.theme-state.json')
        for relative in REQUIRED_OUTPUTS:
            if not (root / relative).is_file():
                raise ValueError(f'Missing rendered output: {relative}; run r2-d2-theme-apply first')
        if command == 'activate':
            atomic_write(state / 'theme.json', json.dumps(data, sort_keys=True, indent=2) + '\n')
    else:
        raise ValueError('Usage: r2-d2-theme-state build ACCENT | render FILE | stage FILE | check | activate')
except (ValueError, KeyError, TypeError, OSError) as error:
    print(f'Theme state: {error}', file=sys.stderr)
    sys.exit(1)
PY
