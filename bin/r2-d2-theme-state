#!/bin/bash

# Internal theme-document helper. Callers hold .theme.lock across render/sync.
# Builds the v2 skyguy-visual theme document from a Material You palette
# generated by matugen. The document carries the source accent, the matugen
# scheme, and the full dark+light color role set, plus a SHA-256 revision over
# the canonical body. The portfolio worker validates that revision without
# re-deriving the palette (the desktop is the authority; matugen is the engine).

set -euo pipefail

export R2D2_PATH="${R2D2_PATH:-$HOME/.local/share/r2-d2}"

python3 - "$@" <<'PY'
import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

root = Path(os.environ['R2D2_PATH'])
state = Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state') / 'r2-d2'
palette_template = root / 'config/theme/matugen/templates/palette.json'
scheme = 'scheme-tonal-spot'

ROLES = [
    'primary', 'on_primary', 'primary_container', 'on_primary_container', 'inverse_primary',
    'secondary', 'on_secondary', 'secondary_container', 'on_secondary_container',
    'tertiary', 'on_tertiary', 'tertiary_container', 'on_tertiary_container',
    'error', 'on_error', 'error_container', 'on_error_container',
    'background', 'on_background',
    'surface', 'on_surface', 'surface_variant', 'on_surface_variant',
    'surface_container', 'surface_container_low', 'surface_container_high',
    'surface_container_highest', 'surface_container_lowest',
    'surface_dim', 'surface_bright', 'surface_tint',
    'outline', 'outline_variant',
    'inverse_surface', 'inverse_on_surface',
    'shadow', 'scrim', 'source_color',
]

# Rendered outputs that must exist before a live sync copies anything. These
# are the repo paths produced by r2-d2-theme-apply's matugen run.
REQUIRED_OUTPUTS = [
    'config/hypr/looknfeel.lua',
    'config/r2-d2/colors.toml', 'config/r2-d2/shell.toml',
    'config/gtk-3.0/gtk.css', 'config/gtk-4.0/gtk.css',
    'config/alacritty/alacritty.toml', 'config/btop/themes/current.theme',
    'config/starship.toml', 'config/zathura/zathurarc',
    'default/config/walker/themes/default/style.css',
    'default/config/hyprland-preview-share-picker/style.css',
    'default/sddm/r2-d2/Palette.qml',
]


def normalize_hex(value):
    if not isinstance(value, str) or not re.fullmatch(r'#[0-9a-fA-F]{6}', value):
        raise ValueError(f'Expected a full #RRGGBB color, got {value!r}')
    return value.upper()


def matugen_palette(source_hex, mode):
    """Run matugen for one mode and return {role: #RRGGBB} (uppercase)."""
    if not palette_template.is_file():
        raise ValueError(f'Missing palette template: {palette_template}')
    with tempfile.TemporaryDirectory(prefix='r2d2-theme-') as tmp:
        tmpdir = Path(tmp)
        config = tmpdir / 'config.toml'
        out = tmpdir / 'palette.json'
        config.write_text(
            '[config]\n'
            f'[templates.palette]\n'
            f'input_path = "{palette_template}"\n'
            f'output_path = "{out}"\n'
        )
        proc = subprocess.run(
            ['matugen', 'color', 'hex', source_hex.lstrip('#'), '--mode', mode,
            '-c', str(config), '-q'],
            capture_output=True, text=True,
        )
        if proc.returncode != 0:
            raise ValueError(f'matugen {mode} failed: {proc.stderr.strip() or proc.stdout.strip()}')
        data = json.loads(out.read_text())
    result = {}
    for role in ROLES:
        if role not in data:
            raise ValueError(f'matugen output missing role: {role}')
        result[role] = normalize_hex(data[role])
    return result


def document(source):
    source = normalize_hex(source)
    dark = matugen_palette(source, 'dark')
    light = matugen_palette(source, 'light')
    data = {
        'version': 2,
        'contract': 'skyguy-visual',
        'contract_version': 2,
        'source': source,
        'scheme': scheme,
        'colors': {'dark': dark, 'light': light},
    }
    body = json.dumps(data, sort_keys=True, separators=(',', ':')).encode()
    data['revision'] = hashlib.sha256(body).hexdigest()
    return data


def load(path):
    if path.stat().st_size > 32768:
        raise ValueError('Theme document exceeds 32 KiB')
    data = json.loads(path.read_text())
    expected = document(data['source'])
    if json.dumps(data, sort_keys=True) != json.dumps(expected, sort_keys=True):
        raise ValueError('Invalid theme schema, colors, or revision')
    return data


def atomic_write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_file() and path.read_text() == content:
        return
    fd, temporary = tempfile.mkstemp(prefix='.' + path.name + '.', dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


try:
    command, *args = sys.argv[1:]
    if command == 'build' and len(args) == 1:
        print(json.dumps(document(args[0]), sort_keys=True, indent=2))
    elif command == 'stage' and len(args) == 1:
        data = load(Path(args[0]))
        atomic_write(root / '.theme-state.json', json.dumps(data, sort_keys=True, indent=2) + '\n')
        atomic_write(state / 'theme-accent', data['source'] + '\n')
    elif command in ('check', 'activate') and not args:
        data = load(root / '.theme-state.json')
        for relative in REQUIRED_OUTPUTS:
            if not (root / relative).is_file():
                raise ValueError(f'Missing rendered output: {relative}; run r2-d2-theme-apply first')
        if command == 'activate':
            atomic_write(state / 'theme.json', json.dumps(data, sort_keys=True, indent=2) + '\n')
    else:
        raise ValueError('Usage: r2-d2-theme-state build ACCENT | stage FILE | check | activate')
except (ValueError, KeyError, TypeError, OSError, subprocess.CalledProcessError) as error:
    print(f'Theme state: {error}', file=sys.stderr)
    sys.exit(1)
PY
