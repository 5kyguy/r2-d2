#!/bin/bash

# Snap the active wallpaper to the nearest named accent in palette.toml.
# Writes the result to ~/.local/state/r2-d2/theme-accent and prints it.
# A missing or unreadable wallpaper is White. Filenames are ignored.

set -euo pipefail

R2D2_ROOT="${R2D2_PATH:-$HOME/.local/share/r2-d2}"
PALETTE="$R2D2_ROOT/config/theme/palette.toml"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/r2-d2"
STATE_FILE="$STATE_DIR/theme-accent"
BACKGROUND_LINK="$R2D2_ROOT/backgrounds/@background"

print_only=false
if [[ ${1:-} == "--print-only" && $# == 1 ]]; then
  print_only=true
elif (( $# > 0 )); then
  echo "Usage: r2-d2-theme-accent-from-bg [--print-only]" >&2
  exit 1
fi

write_accent() {
  local accent="$1"
  if [[ ! $accent =~ ^#[[:xdigit:]]{6}$ ]]; then
    echo "Invalid wallpaper accent: expected #RRGGBB" >&2
    exit 1
  fi
  if [[ $print_only == false ]]; then
    mkdir -p "$STATE_DIR"
    local tmp
    tmp=$(mktemp "$STATE_DIR/.theme-accent.XXXXXX")
    printf '%s\n' "$accent" >"$tmp"
    mv "$tmp" "$STATE_FILE"
  fi
  echo "$accent"
}

IMG=""
if [[ -e $BACKGROUND_LINK ]]; then
  IMG="$(readlink -f "$BACKGROUND_LINK" 2>/dev/null || realpath "$BACKGROUND_LINK")"
fi

accent="$(
  python3 - "$PALETTE" "$IMG" <<'PY'
import colorsys
import math
import re
import subprocess
import sys
import tomllib
from pathlib import Path

VIVID_SATURATION = 0.35
VIVID_VALUE = 0.25
VIVID_FRACTION = 0.02
WHITE_LUMINANCE = 0.45

palette_path = Path(sys.argv[1])
image_path = sys.argv[2]


def hue_of(color):
    channels = [int(color[index:index + 2], 16) / 255 for index in (1, 3, 5)]
    hue, _saturation, _value = colorsys.rgb_to_hsv(*channels)
    return hue * 360


def hue_distance(left, right):
    delta = abs(left - right) % 360
    return min(delta, 360 - delta)


def load_accents():
    with palette_path.open("rb") as handle:
        table = tomllib.load(handle)["accents"]
    black = white = None
    chromatic = []
    for name, item in table.items():
        source = item["source"].upper()
        if item["scheme"] == "scheme-monochrome":
            if name == "black":
                black = source
            elif name == "white":
                white = source
            else:
                raise ValueError(f"Monochrome accent must be black or white, got {name}")
        else:
            chromatic.append((source, hue_of(source)))
    if not black or not white or not chromatic:
        raise ValueError("Palette is missing black, white, or a chromatic accent")
    return black, white, chromatic


def pixels_of(dump):
    pixels = []
    for line in dump.splitlines():
        match = re.search(r"#([0-9A-Fa-f]{6})", line)
        if not match:
            continue
        value = match.group(1)
        pixels.append(tuple(int(value[index:index + 2], 16) for index in (0, 2, 4)))
    return pixels


def classify(pixels, black, white, chromatic):
    vivid = []
    luminances = []
    for red, green, blue in pixels:
        scaled = (red / 255, green / 255, blue / 255)
        hue, saturation, value = colorsys.rgb_to_hsv(*scaled)
        luminances.append(0.2126 * scaled[0] + 0.7152 * scaled[1] + 0.0722 * scaled[2])
        if saturation >= VIVID_SATURATION and value >= VIVID_VALUE:
            vivid.append(hue * 360)
    if len(vivid) / len(pixels) >= VIVID_FRACTION:
        sine = sum(math.sin(math.radians(hue)) for hue in vivid)
        cosine = sum(math.cos(math.radians(hue)) for hue in vivid)
        mean = (math.degrees(math.atan2(sine, cosine)) + 360) % 360
        return min(chromatic, key=lambda item: hue_distance(mean, item[1]))[0]
    luminances.sort()
    index = max(0, math.ceil(0.99 * len(luminances)) - 1)
    if luminances[index] >= WHITE_LUMINANCE:
        return white
    return black


black, white, chromatic = load_accents()
image = Path(image_path) if image_path else None
if image is None or not image.is_file():
    print(white)
    raise SystemExit(0)

proc = subprocess.run(
    ["magick", str(image), "-colorspace", "sRGB", "-resize", "64x64", "-depth", "8", "txt:-"],
    capture_output=True,
    text=True,
)
pixels = pixels_of(proc.stdout) if proc.returncode == 0 else []
print(white if not pixels else classify(pixels, black, white, chromatic))
PY
)"

write_accent "$accent"
