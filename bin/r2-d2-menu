#!/bin/bash

# Open the R2-D2 menu in the command bar, or run one of its actions.
#
#   r2-d2-menu                top level
#   r2-d2-menu <level>        that level (system, screenrecord, setup, …)
#   r2-d2-menu run <id>       run the action the bar selected
#   r2-d2-menu state          which rows exist on this machine, as JSON

export PATH="$HOME/.local/share/r2-d2/bin:$PATH"

menu() {
  local prompt="$1"
  local options="$2"
  local extra="$3"
  local preselect="$4"

  read -r -a args <<<"$extra"

  if [[ -n $preselect ]]; then
    local index
    index=$(echo -e "$options" | grep -nxF "$preselect" | cut -d: -f1)
    if [[ -n $index ]]; then
      args+=("-c" "$index")
    fi
  fi

  echo -e "$options" | r2-d2-launch-walker --dmenu --width 560 --minheight 1 --maxheight 630 -p "$prompt…" "${args[@]}" 2>/dev/null
}

present_terminal() {
  r2-d2-launch-floating-terminal-with-presentation "$1"
}

open_menu() {
  local node=${1:-root}
  [[ $node =~ ^[a-z0-9.-]+$ ]] || node=root
  r2-d2-shell shell summon r2-d2.commandbar "{\"menu\":\"$node\"}"
}

bool() {
  if "$@" >/dev/null 2>&1; then
    echo true
  else
    echo false
  fi
}

any_desktop_exec() {
  local pattern=$1 file
  [[ -d $HOME/.local/share/applications ]] || return 1
  while IFS= read -r -d '' file; do
    grep -qE "$pattern" "$file" && return 0
  done < <(find "$HOME/.local/share/applications" -maxdepth 1 -name '*.desktop' -print0)
  return 1
}

runtime_present() {
  case $1 in
  node) compgen -G "${NVM_DIR:-$HOME/.nvm}/versions/node/v*" >/dev/null ;;
  go) [[ -x /usr/local/go/bin/go ]] ;;
  python) r2-d2-pkg-present python || [[ -x $HOME/.local/bin/uv || -x $HOME/.cargo/bin/uv ]] ;;
  rust) [[ -x $HOME/.cargo/bin/rustup ]] || r2-d2-cmd-present rustup ;;
  *) return 1 ;;
  esac
}

editor_present() {
  case $1 in
  cursor) r2-d2-pkg-present cursor-bin ;;
  vscode) r2-d2-pkg-present visual-studio-code-bin ;;
  t3code) r2-d2-pkg-present t3code-bin ;;
  opencode) [[ -x $HOME/.opencode/bin/opencode ]] || r2-d2-cmd-present opencode ;;
  hermes) [[ -x $HOME/.local/bin/hermes ]] || r2-d2-cmd-present hermes ;;
  *) return 1 ;;
  esac
}

menu_state() {
  local text_size model lid dev_on editor_on dictation_on fingerprint_on fido2_on
  text_size=$(r2-d2-display-text-size 2>/dev/null | awk '/^text size:/{print $3}')
  [[ -n $text_size ]] || text_size=12
  model=$(voxtype config get whisper.model 2>/dev/null | tr -d '[:space:]')
  lid=""
  if r2-d2-hw-laptop >/dev/null 2>&1; then
    lid=$(r2-d2-system-lid-policy status 2>/dev/null | tr -d '[:space:]')
  fi
  if runtime_present node || runtime_present go || runtime_present python || runtime_present rust; then
    dev_on=true
  else
    dev_on=false
  fi
  if editor_present cursor || editor_present vscode || editor_present t3code || editor_present opencode || editor_present hermes; then
    editor_on=true
  else
    editor_on=false
  fi
  if r2-d2-pkg-present voxtype-bin || r2-d2-cmd-present voxtype; then
    dictation_on=true
  else
    dictation_on=false
  fi
  if grep -q pam_fprintd.so /etc/pam.d/sudo 2>/dev/null || r2-d2-pkg-present fprintd; then
    fingerprint_on=true
  else
    fingerprint_on=false
  fi
  if [[ -f /etc/fido2/fido2 ]] || grep -q pam_u2f.so /etc/pam.d/sudo 2>/dev/null; then
    fido2_on=true
  else
    fido2_on=false
  fi

  jq -n \
    --argjson recording "$(bool pgrep -f '[g]pu-screen-recorder')" \
    --argjson suspendOff "$(bool test -f "$HOME/.local/state/r2-d2/toggles/suspend-off")" \
    --argjson hibernate "$(bool r2-d2-hibernation-available)" \
    --argjson laptop "$(bool r2-d2-hw-laptop)" \
    --argjson dockerSudoless "$(bool r2-d2-sudo-docker --configured)" \
    --arg textSize "$text_size" \
    --arg dictationModel "$model" \
    --arg lid "$lid" \
    --argjson webapp "$(bool any_desktop_exec '^Exec=.*(r2-d2-launch-webapp|r2-d2-webapp-handler|helium(-browser)? --app)')" \
    --argjson development "$dev_on" \
    --argjson editor "$editor_on" \
    --argjson dictation "$dictation_on" \
    --argjson fingerprint "$fingerprint_on" \
    --argjson fido2 "$fido2_on" \
    --argjson node "$(bool runtime_present node)" \
    --argjson go "$(bool runtime_present go)" \
    --argjson python "$(bool runtime_present python)" \
    --argjson rust "$(bool runtime_present rust)" \
    --argjson cursor "$(bool editor_present cursor)" \
    --argjson vscode "$(bool editor_present vscode)" \
    --argjson t3code "$(bool editor_present t3code)" \
    --argjson opencode "$(bool editor_present opencode)" \
    --argjson hermes "$(bool editor_present hermes)" \
    '{
      recording: $recording,
      suspendOff: $suspendOff,
      hibernate: $hibernate,
      laptop: $laptop,
      dockerSudoless: $dockerSudoless,
      textSize: $textSize,
      dictationModel: $dictationModel,
      lid: $lid,
      remove: {
        webapp: $webapp,
        development: $development,
        editor: $editor,
        dictation: $dictation,
        fingerprint: $fingerprint,
        fido2: $fido2,
        node: $node,
        go: $go,
        python: $python,
        rust: $rust,
        cursor: $cursor,
        vscode: $vscode,
        t3code: $t3code,
        opencode: $opencode,
        hermes: $hermes
      }
    }'
}

get_webcam_list() {
  v4l2-ctl --list-devices 2>/dev/null | while IFS= read -r line; do
    if [[ $line != $'\t'* && -n $line ]]; then
      local name="$line"
      IFS= read -r device || break
      device=$(echo "$device" | tr -d '\t' | head -1)
      [[ -n $device ]] && echo "$device  $name"
    fi
  done
}

show_webcam_select_menu() {
  local devices
  devices=$(get_webcam_list)
  local count
  count=$(echo "$devices" | grep -c . 2>/dev/null || echo 0)

  if [[ -z $devices ]] || ((count == 0)); then
    r2-d2-notification-send "No webcam devices found" -u critical -t 3000
    return 1
  fi

  if ((count == 1)); then
    echo "$devices" | awk '{print $1}'
  else
    menu "Select Webcam" "$devices" | awk '{print $1}'
  fi
}

pick_default_apps() {
  local category=$1
  local title=$2
  local options current choice desktop

  options=$(r2-d2-setup-default-apps list "$category")
  current=$(r2-d2-setup-default-apps current "$category")
  if [[ -n $current ]] && ! grep -qxF "$current" <<<"$options"; then
    if [[ -n $options ]]; then
      options="${current}"$'\n'"${options}"
    else
      options=$current
    fi
  fi

  if [[ -z $options ]]; then
    r2-d2-notification-send "Default apps" "No installed app handles ${category} files"
    return
  fi

  choice=$(menu "$title" "$options" "" "$current")
  case $choice in
  CNCLD | "") return ;;
  *)
    desktop=${choice%%  *}
    r2-d2-setup-default-apps set "$category" "$desktop"
    ;;
  esac
}

apply_text_size() {
  local current size
  current=$(r2-d2-display-text-size 2>/dev/null | awk '/^text size:/{print $3}')
  size=$(gum input --placeholder "Text size 9–20" --value "${current:-12}")
  [[ -n $size && $size != "CNCLD" ]] && r2-d2-display-text-size "$size"
}

run_action() {
  case $1 in
  screenshot) r2-d2-cmd-screenshot ;;
  share.clipboard) r2-d2-cmd-share clipboard ;;
  share.file) present_terminal "r2-d2-cmd-share file" ;;
  share.folder) present_terminal "r2-d2-cmd-share folder" ;;
  screenrecord.stop) r2-d2-cmd-screenrecord --stop-recording ;;
  screenrecord.none) r2-d2-cmd-screenrecord ;;
  screenrecord.desktop) r2-d2-cmd-screenrecord --with-desktop-audio ;;
  screenrecord.mic) r2-d2-cmd-screenrecord --with-desktop-audio --with-microphone-audio ;;
  screenrecord.webcam)
    local device
    device=$(show_webcam_select_menu) || exit 0
    r2-d2-cmd-screenrecord --with-desktop-audio --with-microphone-audio --with-webcam --webcam-device="$device"
    ;;
  toggle.bar) r2-d2-toggle-waybar ;;
  toggle.display) r2-d2-toggle-builtin-display ;;
  toggle.mirror) r2-d2-toggle-display-mirror ;;
  toggle.notifications) r2-d2-toggle-notification-silencing ;;
  toggle.idle) r2-d2-toggle-idle ;;
  toggle.layout) r2-d2-hyprland-workspace-layout-toggle ;;
  toggle.scaling) r2-d2-hyprland-monitor-scaling-toggle ;;
  toggle.screensaver) r2-d2-toggle-screensaver ;;
  toggle.crash) r2-d2-toggle-crash-capture ;;
  capture.qr) r2-d2-capture-qr ;;
  setup.dns) present_terminal r2-d2-setup-dns ;;
  setup.webcam | webcam) present_terminal r2-d2-fix-amd-webcam ;;
  setup.doctor | doctor) present_terminal r2-d2-cmd-doctor ;;
  setup.reset-sudo) present_terminal r2-d2-reset-sudo ;;
  text.10) r2-d2-display-text-size 10 ;;
  text.12) r2-d2-display-text-size 12 ;;
  text.14) r2-d2-display-text-size 14 ;;
  text.16) r2-d2-display-text-size 16 ;;
  text.custom) present_terminal "r2-d2-menu run text.apply" ;;
  text.apply) apply_text_size ;;
  defaults.text) pick_default_apps text "Text" ;;
  defaults.pdf) pick_default_apps pdf "PDF" ;;
  defaults.images) pick_default_apps images "Images" ;;
  defaults.video) pick_default_apps video "Video" ;;
  monitors.save.docked) r2-d2-hyprland-monitor-profile save docked ;;
  monitors.save.laptop) r2-d2-hyprland-monitor-profile save laptop ;;
  monitors.apply.docked) r2-d2-hyprland-monitor-profile apply docked ;;
  monitors.apply.laptop) r2-d2-hyprland-monitor-profile apply laptop ;;
  sleep.suspend) r2-d2-toggle-suspend ;;
  sleep.hibernate.on) present_terminal r2-d2-hibernation-setup ;;
  sleep.hibernate.off) present_terminal r2-d2-hibernation-remove ;;
  lid.suspend) present_terminal "r2-d2-system-lid-policy suspend" ;;
  lid.lock) present_terminal "r2-d2-system-lid-policy lock" ;;
  lid.ignore) present_terminal "r2-d2-system-lid-policy ignore" ;;
  security.fingerprint) present_terminal r2-d2-setup-fingerprint ;;
  security.fido2) present_terminal r2-d2-setup-fido2 ;;
  security.docker.on) present_terminal r2-d2-setup-security-sudoless-docker ;;
  security.docker.off) present_terminal r2-d2-remove-security-sudoless-docker ;;
  dictation.config) present_terminal r2-d2-voxtype-config ;;
  dictation.status) present_terminal r2-d2-voxtype-status ;;
  dictation.model.tiny.en) present_terminal "r2-d2-voxtype-model tiny.en" ;;
  dictation.model.base.en) present_terminal "r2-d2-voxtype-model base.en" ;;
  dictation.model.small.en) present_terminal "r2-d2-voxtype-model small.en" ;;
  dictation.model.medium.en) present_terminal "r2-d2-voxtype-model medium.en" ;;
  dictation.model.large-v3-turbo) present_terminal "r2-d2-voxtype-model large-v3-turbo" ;;
  restart.shell) r2-d2-restart-shell ;;
  restart.walker) r2-d2-restart-walker ;;
  restart.pipewire) r2-d2-restart-pipewire ;;
  restart.terminal) r2-d2-restart-terminal ;;
  restart.wifi) r2-d2-restart-wifi ;;
  restart.bluetooth) r2-d2-restart-bluetooth ;;
  restart.hyprctl) r2-d2-restart-hyprctl ;;
  install.package) present_terminal r2-d2-pkg-install ;;
  install.aur) present_terminal r2-d2-pkg-aur-install ;;
  install.webapp) present_terminal r2-d2-webapp-install ;;
  install.appimage) present_terminal r2-d2-appimage-install ;;
  install.k2so) present_terminal r2-d2-install-k2so ;;
  install.gaming) present_terminal "r2-d2-install-steam; r2-d2-install-xbox-controllers" ;;
  install.dropbox) present_terminal r2-d2-install-dropbox ;;
  install.tailscale) present_terminal r2-d2-install-tailscale ;;
  install.dev.node) present_terminal "r2-d2-install-dev-env node" ;;
  install.dev.go) present_terminal "r2-d2-install-dev-env go" ;;
  install.dev.python) present_terminal "r2-d2-install-dev-env python" ;;
  install.dev.rust) present_terminal "r2-d2-install-dev-env rust" ;;
  install.editor.cursor) present_terminal "r2-d2-install-editor cursor" ;;
  install.editor.vscode) present_terminal "r2-d2-install-editor vscode" ;;
  install.editor.t3code) present_terminal "r2-d2-install-editor t3code" ;;
  install.editor.opencode) present_terminal "r2-d2-install-editor opencode" ;;
  install.editor.hermes) present_terminal "r2-d2-install-editor hermes" ;;
  remove.package) present_terminal r2-d2-pkg-remove ;;
  remove.drop) present_terminal r2-d2-pkg-drop ;;
  remove.webapp) present_terminal r2-d2-webapp-remove ;;
  remove.webapps) present_terminal r2-d2-webapp-remove-all ;;
  remove.dictation) present_terminal r2-d2-voxtype-remove ;;
  remove.fingerprint) present_terminal "r2-d2-setup-fingerprint --remove" ;;
  remove.fido2) present_terminal "r2-d2-setup-fido2 --remove" ;;
  remove.docker) present_terminal r2-d2-remove-security-sudoless-docker ;;
  remove.dev.node) present_terminal "r2-d2-remove-dev-env node" ;;
  remove.dev.go) present_terminal "r2-d2-remove-dev-env go" ;;
  remove.dev.python) present_terminal "r2-d2-remove-dev-env python" ;;
  remove.dev.rust) present_terminal "r2-d2-remove-dev-env rust" ;;
  remove.editor.cursor) present_terminal "r2-d2-remove-editor cursor" ;;
  remove.editor.vscode) present_terminal "r2-d2-remove-editor vscode" ;;
  remove.editor.t3code) present_terminal "r2-d2-remove-editor t3code" ;;
  remove.editor.opencode) present_terminal "r2-d2-remove-editor opencode" ;;
  remove.editor.hermes) present_terminal "r2-d2-remove-editor hermes" ;;
  update.full) present_terminal r2-d2-update ;;
  update.config) present_terminal r2-d2-update-config ;;
  update.packages) present_terminal r2-d2-update-packages ;;
  update.webcam) present_terminal r2-d2-fix-amd-webcam ;;
  update.timezone) present_terminal "r2-d2-tz-select && r2-d2-update-time" ;;
  update.password.drive) present_terminal r2-d2-drive-set-password ;;
  update.password.user) present_terminal passwd ;;
  reinstall.full) present_terminal r2-d2-reinstall ;;
  reinstall.packages) present_terminal r2-d2-reinstall-pkgs ;;
  reinstall.configs) present_terminal r2-d2-reinstall-configs ;;
  reinstall.git) present_terminal r2-d2-reinstall-git ;;
  about) r2-d2-launch-about ;;
  system.screensaver) r2-d2-launch-screensaver force ;;
  system.lock) r2-d2-lock-screen ;;
  system.suspend) systemctl suspend ;;
  system.hibernate) systemctl hibernate ;;
  system.logout) r2-d2-system-logout ;;
  system.reboot) r2-d2-system-reboot ;;
  system.shutdown) r2-d2-system-shutdown ;;
  *) exit 1 ;;
  esac
}

case ${1:-} in
state) menu_state ;;
run)
  [[ -n ${2:-} ]] || exit 1
  run_action "$2"
  ;;
"")
  open_menu root
  ;;
screenrecord)
  r2-d2-cmd-screenrecord --stop-recording && exit 0
  open_menu screenrecord
  ;;
doctor | webcam | about)
  run_action "$1"
  ;;
*)
  open_menu "$1"
  ;;
esac
