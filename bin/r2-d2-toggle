#!/bin/bash

# Toggle feature flags under ~/.local/state/r2-d2/toggles/
# Usage: r2-d2-toggle <flag-name> [toggle|on|off]

if (($# < 1)); then
  echo "Usage: r2-d2-toggle <flag-name> [toggle|on|off]" >&2
  exit 1
fi

FLAG_NAME="$1"
ACTION="${2:-toggle}"
FLAG="$HOME/.local/state/r2-d2/toggles/$FLAG_NAME"

enable() {
  mkdir -p "$(dirname "$FLAG")"
  touch "$FLAG"
}

disable() {
  rm -f "$FLAG"
}

case "$ACTION" in
toggle | "")
  if [[ -f $FLAG ]]; then
    disable
  else
    enable
  fi
  ;;
on)
  enable
  ;;
off)
  disable
  ;;
*)
  echo "Usage: r2-d2-toggle <flag-name> [toggle|on|off]" >&2
  exit 1
  ;;
esac
