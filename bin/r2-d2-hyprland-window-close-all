#!/bin/bash

# Close all open windows, then move to workspace 1.
# Uses Lua dispatchers (Hyprland 0.55+).

hyprctl clients -j |
  jq -r '.[].address' |
  while read -r addr; do
    [[ -n $addr ]] || continue
    hyprctl dispatch "hl.dsp.window.close({ window = \"$addr\" })" >/dev/null 2>&1 || true
  done

hyprctl dispatch "hl.dsp.focus({ workspace = 1 })"
