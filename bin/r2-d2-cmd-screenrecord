#!/bin/bash

# Start and stop a screenrecording, which will be saved to ~/Videos by default.
# Alternative location can be set via R2D2_SCREENRECORD_DIR or XDG_VIDEOS_DIR ENVs.
# Resolution is capped to 4K for monitors above 4K, native otherwise.
# Override via --resolution= (e.g. --resolution=1920x1080, --resolution=0x0 for native).
#
# Backend:
#   Default interactive capture uses KMS via slurp (r2-d2-capture-region).
#   --choose-target asks for a window, a screen, or a drawn area.
#   Window lists mapped windows and records the one you pick.
#   Screen lists monitors and records the one you pick.
#   Area still uses the region picker.
#   --fullscreen targets the focused monitor (agent-safe, no picker).
#   Set R2D2_SCREENRECORD_USE_PORTAL=true for HDR / eGPU / window portal capture.

# shellcheck source=/dev/null
[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${R2D2_SCREENRECORD_DIR:-${XDG_VIDEOS_DIR:-$HOME/Videos}}"

if [[ ! -d $OUTPUT_DIR ]]; then
  r2-d2-notification-send -u critical -t 3000 "Screen recording directory does not exist: $OUTPUT_DIR"
  exit 1
fi

DESKTOP_AUDIO="false"
MICROPHONE_AUDIO="false"
WEBCAM="false"
WEBCAM_DEVICE=""
RESOLUTION=""
STOP_RECORDING="false"
FULLSCREEN="false"
CHOOSE_TARGET="false"
TARGET_MODE=""
RECORDING_FILE="/tmp/r2-d2-screenrecord-filename"

for arg in "$@"; do
  case "$arg" in
  --with-desktop-audio) DESKTOP_AUDIO="true" ;;
  --with-microphone-audio) MICROPHONE_AUDIO="true" ;;
  --with-webcam) WEBCAM="true" ;;
  --webcam-device=*) WEBCAM_DEVICE="${arg#*=}" ;;
  --stop-recording) STOP_RECORDING="true" ;;
  --resolution=*) RESOLUTION="${arg#*=}" ;;
  --fullscreen) FULLSCREEN="true" ;;
  --choose-target) CHOOSE_TARGET="true" ;;
  esac
done

start_webcam_overlay() {
  cleanup_webcam

  if [[ -z $WEBCAM_DEVICE ]]; then
    WEBCAM_DEVICE=$(v4l2-ctl --list-devices 2>/dev/null | grep -m1 "^\s*/dev/video" | tr -d '\t')
    if [[ -z $WEBCAM_DEVICE ]]; then
      r2-d2-notification-send -u critical -t 3000 "No webcam devices found"
      return 1
    fi
  fi

  local scale
  scale=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .scale')

  local target_width
  target_width=$(awk "BEGIN {printf \"%.0f\", 360 * $scale}")

  local preferred_resolutions=("640x360" "1280x720" "1920x1080")
  local video_size_arg=""
  local available_formats
  available_formats=$(v4l2-ctl --list-formats-ext -d "$WEBCAM_DEVICE" 2>/dev/null)

  for resolution in "${preferred_resolutions[@]}"; do
    if echo "$available_formats" | grep -q "$resolution"; then
      video_size_arg="-video_size $resolution"
      break
    fi
  done

  ffplay -f v4l2 "$video_size_arg" -framerate 30 "$WEBCAM_DEVICE" \
    -vf "scale=${target_width}:-1" \
    -window_title "WebcamOverlay" \
    -noborder \
    -fflags nobuffer -flags low_delay \
    -probesize 32 -analyzeduration 0 \
    -loglevel quiet &
  sleep 1
}

default_resolution() {
  local width height
  read -r width height < <(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | "\(.width) \(.height)"')
  if ((width > 3840 || height > 2160)); then
    echo "3840x2160"
  else
    echo "0x0"
  fi
}

cleanup_webcam() {
  pkill -f "WebcamOverlay" 2>/dev/null
}

geometry_target() {
  local selection=$1
  [[ $selection =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]] || return 1
  echo "region:${BASH_REMATCH[3]}x${BASH_REMATCH[4]}+${BASH_REMATCH[1]}+${BASH_REMATCH[2]}"
}

choose_target() {
  local choice
  choice=$(printf '%s\n' "  Window" "󰍹  Screen" "  Area" | r2-d2-launch-walker --dmenu --width 560 --minheight 1 --maxheight 630 -p "Screenrecord…" 2>/dev/null) || return 1

  case $choice in
  *Window) TARGET_MODE=window ;;
  *Screen) TARGET_MODE=screen ;;
  *Area) TARGET_MODE=area ;;
  *) return 1 ;;
  esac
}

pick_menu() {
  local prompt=$1
  local options=$2
  [[ -n $options ]] || return 1
  printf '%s\n' "$options" | r2-d2-launch-walker --dmenu --width 560 --minheight 1 --maxheight 630 -p "$prompt…" 2>/dev/null
}

# address, label, x, y, width, height
window_rows() {
  hyprctl clients -j | jq -r '
    def clean:
      gsub("[\n\t]"; " ") | gsub(" +"; " ") | sub("^ +"; "") | sub(" +$"; "");
    def app:
      ((.class // .initialClass // "window") | split(".") | last);
    [ .[]
      | select(.mapped == true and .hidden != true)
      | select(.size[0] > 1 and .size[1] > 1)
      | select((.class // "") != "walker")
      | .label = ((.title // "") | clean)
      | if .label == "" then .label = app else . end
    ]
    | group_by(.label)
    | map(if length == 1 then . else map(.label = .label + "  ·  " + app) end)
    | flatten
    | group_by(.label)
    | map(
        if length == 1 then .
        else to_entries | map(.value.label = .value.label + " " + ((.key + 1) | tostring)) | map(.value)
        end
      )
    | flatten
    | sort_by(.focusHistoryID // 999999)
    | .[]
    | [.address, .label, (.at[0] | tostring), (.at[1] | tostring), (.size[0] | tostring), (.size[1] | tostring)]
    | @tsv
  '
}

focus_window() {
  local address=$1
  hyprctl dispatch "hl.dsp.focus({ window = \"address:${address}\" })" >/dev/null 2>&1 || return 0
  sleep 0.2
}

window_region() {
  local address=$1
  hyprctl clients -j | jq -er --arg address "$address" '
    .[]
    | select(.address == $address)
    | "region:\(.size[0])x\(.size[1])+\(.at[0])+\(.at[1])"
  '
}

choose_window_region() {
  local rows choice address label region
  local -a lines=()
  local -A addresses=()

  rows=$(window_rows) || return 1
  if [[ -z $rows ]]; then
    r2-d2-notification-send -u critical -t 3000 "No windows to record"
    return 1
  fi

  while IFS=$'\t' read -r address label _; do
    [[ -n $address && -n $label ]] || continue
    lines+=("  $label")
    addresses["  $label"]=$address
  done <<<"$rows"

  choice=$(pick_menu "Window" "$(printf '%s\n' "${lines[@]}")") || return 1
  address=${addresses[$choice]}
  [[ -n $address ]] || return 1

  focus_window "$address"
  region=$(window_region "$address") || return 1
  printf '%s\n' "$region"
}

choose_screen() {
  local rows choice name resolution model label
  local -a lines=()
  local -A names=()

  rows=$(hyprctl monitors -j | jq -r '
    .[]
    | . as $monitor
    | [
        $monitor.name,
        "\($monitor.width)x\($monitor.height)",
        (if (($monitor.model // "") == "" or (($monitor.model // "") | test("^0x"))) then "" else $monitor.model end)
      ]
    | @tsv
  ')

  if [[ -z $rows ]]; then
    r2-d2-notification-send -u critical -t 3000 "No screens to record"
    return 1
  fi

  while IFS=$'\t' read -r name resolution model; do
    [[ -n $name ]] || continue
    if [[ -n $model ]]; then
      label="󰍹  ${name}  ${model}  ${resolution}"
    else
      label="󰍹  ${name}  ${resolution}"
    fi
    lines+=("$label")
    names[$label]=$name
  done <<<"$rows"

  choice=$(pick_menu "Screen" "$(printf '%s\n' "${lines[@]}")") || return 1
  name=${names[$choice]}
  [[ -n $name ]] || return 1
  printf 'monitor:%s\n' "$name"
}

select_capture_target() {
  local target

  case $TARGET_MODE in
  window)
    choose_window_region
    ;;
  area)
    target=$(r2-d2-capture-region region) || return 1
    geometry_target "$target"
    ;;
  screen)
    choose_screen
    ;;
  *)
    target=$(r2-d2-capture-region smart --match-monitor) || return 1

    if [[ $target == monitor:* ]]; then
      echo "$target"
      return
    fi

    geometry_target "$target"
    ;;
  esac
}

start_screenrecording() {
  local filename
  filename="$OUTPUT_DIR/screenrecording-$(date +'%Y-%m-%d_%H-%M-%S').mp4"
  local audio_devices=""
  local -a audio_args=()
  local -a capture_args=()
  local target=""

  [[ $DESKTOP_AUDIO == "true" ]] && audio_devices+="default_output"

  if [[ $MICROPHONE_AUDIO == "true" ]]; then
    [[ -n $audio_devices ]] && audio_devices+="|"
    audio_devices+="default_input"
  fi

  [[ -n $audio_devices ]] && audio_args+=(-a "$audio_devices" -ac aac)

  local resolution="${RESOLUTION:-$(default_resolution)}"

  if [[ $FULLSCREEN == "true" ]]; then
    target="monitor:$(r2-d2-hyprland-monitor-focused)"
    capture_args=(-w "${target#monitor:}" -s "$resolution")
  elif [[ ${R2D2_SCREENRECORD_USE_PORTAL:-false} == "true" ]]; then
    target="portal"
    capture_args=(-w portal -s "$resolution")
  else
    target=$(select_capture_target) || return 1
    case $target in
    monitor:*)
      capture_args=(-w "${target#monitor:}" -s "$resolution")
      ;;
    region:*)
      capture_args=(-w "${target#region:}")
      [[ -n $RESOLUTION ]] && capture_args+=(-s "$RESOLUTION")
      ;;
    esac
  fi

  gpu-screen-recorder "${capture_args[@]}" -k auto -f 60 -fm cfr -fallback-cpu-encoding yes -o "$filename" "${audio_args[@]}" &

  local waited=0
  while [[ ! -f $filename ]] && ((waited < 600)); do
    sleep 0.2
    waited=$((waited + 1))
    if ((waited >= 25)) && ! pgrep -f "[g]pu-screen-recorder" >/dev/null; then
      break
    fi
  done

  if [[ -f $filename ]]; then
    echo "$filename" >"$RECORDING_FILE"
    toggle_screenrecording_indicator
    return 0
  fi

  r2-d2-notification-send -u critical -t 6000 "Screen recording failed" "No recording file was created. Check GPU drivers and gpu-screen-recorder."
  return 1
}

stop_screenrecording() {
  pkill -SIGINT -f "[g]pu-screen-recorder"

  local count=0
  while pgrep -f "[g]pu-screen-recorder" >/dev/null && ((count < 50)); do
    sleep 0.1
    count=$((count + 1))
  done

  toggle_screenrecording_indicator
  cleanup_webcam

  if pgrep -f "[g]pu-screen-recorder" >/dev/null; then
    pkill -9 -f "[g]pu-screen-recorder"
    r2-d2-notification-send -u critical -t 5000 "Screen recording error" "Recording process had to be force-killed. Video may be corrupted."
  else
    trim_first_frame
    local filename
    filename=$(cat "$RECORDING_FILE" 2>/dev/null)
    local preview="${filename%.mp4}-preview.png"

    [[ -n $filename ]] && echo "$filename"

    ffmpeg -y -i "$filename" -ss 00:00:00.1 -vframes 1 -q:v 2 "$preview" -loglevel quiet 2>/dev/null

    (
      ACTION=$(r2-d2-notification-send -a --urgency normal --image "${preview:-$filename}" "Screen recording saved" "Open with Super + Alt + , (or click this)" -t 10000)
      [[ $ACTION == "default" ]] && mpv "$filename"
      rm -f "$preview"
    ) &
  fi
  rm -f "$RECORDING_FILE"
}

toggle_screenrecording_indicator() {
  r2-d2-shell -q r2-d2.indicators refresh || true
}

screenrecording_active() {
  pgrep -f "[g]pu-screen-recorder" >/dev/null
}

trim_first_frame() {
  local latest
  latest=$(cat "$RECORDING_FILE" 2>/dev/null)

  if [[ -n $latest && -f $latest ]]; then
    local trimmed="${latest%.mp4}-trimmed.mp4"
    if ffmpeg -y -ss 0.1 -i "$latest" -c copy "$trimmed" -loglevel quiet 2>/dev/null; then
      mv "$trimmed" "$latest"
    else
      rm -f "$trimmed"
    fi
  fi
}

if screenrecording_active; then
  stop_screenrecording
elif [[ $STOP_RECORDING == "true" ]]; then
  exit 1
else
  if [[ $CHOOSE_TARGET == "true" ]]; then
    choose_target || exit 0
  fi

  [[ $WEBCAM == "true" ]] && start_webcam_overlay

  start_screenrecording || cleanup_webcam
fi
