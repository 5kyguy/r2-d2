#!/bin/bash

# Reload desktop components after themed config changes (update prompt or wallpaper pick).
# Hyprland border colors are applied via r2-d2-theme-hyprland-apply (no full hyprctl reload).

set -euo pipefail

accent="${1:-}"

r2-d2-theme-hyprland-apply >/dev/null 2>&1 || true

r2-d2-restart-walker >/dev/null 2>&1 || true
if [[ -f $HOME/.config/r2-d2/colors.toml && -f $HOME/.config/r2-d2/shell.toml ]]; then
  colors=$(base64 -w0 "$HOME/.config/r2-d2/colors.toml")
  shell_theme=$(base64 -w0 "$HOME/.config/r2-d2/shell.toml")
  r2-d2-shell -q shell applyTheme "$colors" "$shell_theme" || true
fi

# Writing looknfeel.lua makes Hyprland reload, which re-enables every output.
r2-d2-hyprland-monitors-restore --flags-only >/dev/null 2>&1 || true

if [[ -n $accent ]] && command -v notify-send >/dev/null 2>&1; then
  notify-send "R2-D2 theme" "Accent: $accent" -t 2500
fi
