#!/bin/bash

# Toggle single-window square aspect ratio via hl.config (Lua).

CURRENT_VALUE=$(hyprctl getoption "layout:single_window_aspect_ratio" -j 2>/dev/null)

if echo "$CURRENT_VALUE" | jq -e '.vec2 == [1,1] or .vec2 == [1.0,1.0]' >/dev/null 2>&1; then
  hyprctl eval 'hl.config({ layout = { single_window_aspect_ratio = { 0, 0 } } })'
  notify-send "    Disable single-window square aspect ratio"
else
  hyprctl eval 'hl.config({ layout = { single_window_aspect_ratio = { 1, 1 } } })'
  notify-send "    Enable single-window square aspect"
fi
