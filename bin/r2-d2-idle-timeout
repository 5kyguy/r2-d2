#!/bin/bash

# Idle step for hypridle: lock the session. Everything that follows the lock
# (screensaver after two minutes on AC, battery display blanking) is owned by
# the shell lock service, which arms its timers per lock.

case ${1:-} in
  lock)
    loginctl lock-session
    ;;
  *)
    echo "Usage: r2-d2-idle-timeout <lock>" >&2
    exit 1
    ;;
esac
