#!/bin/bash

# Launch or focus on a given command identified by the passed in window-pattern.
# Use by some default bindings, like the one for Spotify, to ensure there is only one instance of the application open.

if (($# == 0)); then
  echo "Usage: r2-d2-launch-or-focus [window-pattern] [launch-command...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift

if (($# > 0)); then
  LAUNCH_COMMAND="$*"
else
  LAUNCH_COMMAND="uwsm-app -- $WINDOW_PATTERN"
fi

WINDOW_ADDRESS=$(hyprctl clients -j | jq -r --arg p "$WINDOW_PATTERN" '.[]|select((.class|test("\\b" + $p + "\\b";"i")) or (.title|test("\\b" + $p + "\\b";"i")))|.address' | head -n1)

# Floating windows keep coordinates from a monitor that has since disconnected.
# Focus alone leaves them off-screen, so the click looks like a no-op.
window_on_screen() {
  local address="$1"
  local clients monitors

  clients=$(hyprctl clients -j)
  monitors=$(hyprctl monitors -j)
  jq -e --arg address "$address" --argjson monitors "$monitors" '
    .[] | select(.address == $address) as $w
    | $monitors
    | map(
        ($w.at[0] < (.x + .width)) and
        (($w.at[0] + $w.size[0]) > .x) and
        ($w.at[1] < (.y + .height)) and
        (($w.at[1] + $w.size[1]) > .y)
      )
    | any
  ' <<<"$clients" >/dev/null
}

if [[ -n $WINDOW_ADDRESS ]]; then
  if ! window_on_screen "$WINDOW_ADDRESS"; then
    hyprctl dispatch "hl.dsp.window.center({ window = \"address:$WINDOW_ADDRESS\" })" >/dev/null
  fi
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$WINDOW_ADDRESS\" })"
else
  eval exec setsid $LAUNCH_COMMAND
fi
