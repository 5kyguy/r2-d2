#!/bin/bash

# Take a screenshot of the whole screen, a specific window, or a user-drawn region.
# Saves to ~/Pictures by default, but that can be changed via R2D2_SCREENSHOT_DIR or XDG_PICTURES_DIR ENVs.
# Editor defaults to Satty but can be changed via --editor=<name> or R2D2_SCREENSHOT_EDITOR env
#
# Usage: r2-d2-cmd-screenshot [mode] [processing]
#   mode:        smart (default) | region | windows | fullscreen
#   processing:  slurp (default, save + clipboard + edit-on-click) | copy (clipboard only) | save (file only)
#
# The `save` mode is built for agents: writes the PNG and echoes the path to
# stdout without touching the clipboard or firing interactive notifications.
# In `slurp` mode the path is also echoed so the MCP screenshot tool can read it.

# shellcheck source=/dev/null
[[ -f ~/.config/user-dirs.dirs ]] && source ~/.config/user-dirs.dirs
OUTPUT_DIR="${R2D2_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}}"

mkdir -p "$OUTPUT_DIR"

pkill slurp && exit 0

SCREENSHOT_EDITOR="${R2D2_SCREENSHOT_EDITOR:-satty}"

# Parse --editor flag from any position
ARGS=()
for arg in "$@"; do
  if [[ $arg == --editor=* ]]; then
    SCREENSHOT_EDITOR="${arg#--editor=}"
  else
    ARGS+=("$arg")
  fi
done
set -- "${ARGS[@]}"

open_editor() {
  local filepath="$1"
  if [[ $SCREENSHOT_EDITOR == "satty" ]]; then
    satty --filename "$filepath" \
      --output-filename "$filepath" \
      --actions-on-enter save-to-clipboard \
      --save-after-copy \
      --copy-command 'wl-copy'
  else
    $SCREENSHOT_EDITOR "$filepath"
  fi
}

MODE="${1:-smart}"
PROCESSING="${2:-slurp}"

# Keep freeze alive until after grim so the capture sees the frozen overlay.
cleanup_freeze() {
  [[ -n ${FREEZE_PID:-} ]] && kill "$FREEZE_PID" 2>/dev/null || true
}
trap cleanup_freeze EXIT

# First line is freeze PID (may be empty); second is geometry.
pick_output=$(r2-d2-capture-region "$MODE" --keep-freeze) || exit 0
FREEZE_PID=$(printf '%s\n' "$pick_output" | sed -n '1p')
SELECTION=$(printf '%s\n' "$pick_output" | sed -n '2p')

[[ -z $SELECTION ]] && exit 0

FILENAME="screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"
FILEPATH="$OUTPUT_DIR/$FILENAME"

if [[ $PROCESSING == "slurp" ]]; then
  grim -g "$SELECTION" "$FILEPATH" || exit 1
  echo "$FILEPATH"
  wl-copy --type image/png <"$FILEPATH"

  (
    ACTION=$(r2-d2-notification-send -a --urgency normal --image "$FILEPATH" "Screenshot saved to clipboard and file" "Edit with Super + Alt + , (or click this)" -t 10000)
    [[ $ACTION == "default" ]] && open_editor "$FILEPATH"
  ) &
elif [[ $PROCESSING == "save" ]]; then
  # Agent-friendly: file only, no clipboard, no interactive notification.
  grim -g "$SELECTION" "$FILEPATH" || exit 1
  echo "$FILEPATH"
else
  grim -g "$SELECTION" - | wl-copy --type image/png
fi
