#!/bin/bash

daemon="${HOME}/.local/bin/den-den-mushi"
if [[ ! -x $daemon ]]; then
  daemon=$(command -v den-den-mushi || true)
fi
state=$([[ -n $daemon ]] && "$daemon" dnd toggle || true)

if [[ $state == "on" ]]; then
  r2-d2-notification-send --app-name r2-d2-action "󰂛    Silenced notifications"
else
  r2-d2-notification-send --app-name r2-d2-action "󰂚    Enabled notifications"
fi

r2-d2-shell -q r2-d2.indicators refresh || true
