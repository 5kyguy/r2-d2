#!/bin/bash

STATE_FILE=~/.local/state/r2-d2/toggles/screensaver-off

if [[ -f $STATE_FILE ]]; then
  rm -f $STATE_FILE
  r2-d2-notification-send --app-name r2-d2-action "󱄄   Screensaver enabled"
else
  mkdir -p "$(dirname $STATE_FILE)"
  touch $STATE_FILE
  r2-d2-notification-send --app-name r2-d2-action "󱄄   Screensaver disabled"
fi
